@model DamageReportListPage
@{ViewData["Title"]="ข้อความและรายงานจากลูกค้า";}
<div class="page-heading"><p class="eyebrow">ดูแลสนามและอุปกรณ์</p><h1>ข้อความและรายงานปัญหา</h1><p>ตรวจสอบปัญหาจากลูกค้า อัปเดตสถานะและแจ้งผลการแก้ไขให้ลูกค้าทราบ</p></div>
<form method="get" class="filter-panel"><div><label for="damage-status">สถานะ</label><select name="status" id="damage-status"><option value="">ทุกสถานะ</option>@foreach(var status in DamageReport.Statuses.Concat(DamageClaim.Statuses)){<option value="@status" selected="@(Model.Status==status)">@DamageClaim.Label(status)</option>}</select></div><button class="button" type="submit">ค้นหารายงาน</button></form>
<p class="help">พบ @Model.Reports.Count รายงาน การรับรายงานไม่ปิดสนามหรือปิดอุปกรณ์อัตโนมัติ ผู้ดูแลตรวจสอบและจัดการที่เมนูตารางเวลาหรืออุปกรณ์เสริมได้</p>
@foreach(var report in Model.Reports){<section class="panel"><p><strong>@report.Subject</strong>@if(report.BookingId.HasValue&&report.PlayDate.HasValue){<span> · @CourtTime.Display(report.PlayDate.Value) · </span><a class="inline-link" asp-action="Booking" asp-route-id="@report.BookingId">CB@(report.BookingId.Value.ToString("000000"))</a>}else{<span class="help"> · แจ้งโดยตรง</span>}</p><p class="help">ผู้แจ้ง @report.MemberName · @report.MemberEmail</p><partial name="_DamageReport" model="report"/>
@if(report.Claim is null){<form method="post" asp-action="UpdateDamageReport" asp-route-id="@report.Id"><label for="status-@report.Id">สถานะการแก้ไข</label><select name="Status" id="status-@report.Id">@foreach(var status in DamageReport.Statuses){<option value="@status" selected="@(report.Status==status)">@DamageReport.Label(status)</option>}</select><label for="note-@report.Id">หมายเหตุ / คำตอบถึงลูกค้า</label><textarea id="note-@report.Id" name="AdminNote" rows="3" maxlength="1000">@report.AdminNote</textarea><p class="help">ลูกค้าจะเห็นข้อความนี้ในหน้ารายงานของตนเอง (ไม่เกิน 1,000 ตัวอักษร)</p><button class="button" type="submit">บันทึกสถานะ</button></form>}
</section>}
@if(Model.Reports.Count==0){<section class="panel"><p class="empty">ไม่มีรายงานในสถานะที่เลือก</p></section>}
