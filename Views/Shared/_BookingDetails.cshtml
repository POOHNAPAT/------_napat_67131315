@model Booking
@if(Model.CancelledAt is not null){<p class="help">ลูกค้ายกเลิกเมื่อ @DateTimeOffset.Parse(Model.CancelledAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p>}
<p><span class="pill">@Model.PaymentStatusLabel</span></p>
@if(Model.PaymentSubmittedAt is not null){<p class="help">แจ้งโอน: @Model.TransferReference · @DateTimeOffset.Parse(Model.PaymentSubmittedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p><a class="inline-link" asp-controller="@(Context.Items["AdminPortal"] is true?"Admin":"Bookings")" asp-action="PaymentSlip" asp-route-id="@Model.Id" target="_blank" rel="noopener">ดูหลักฐานโอน ↗</a>}
@if(Model.ConfirmedAt is not null){<p class="help">ยืนยันการจองโดย @Model.ConfirmedByName · @DateTimeOffset.Parse(Model.ConfirmedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p>}
@if(Model.PaidAt is not null){<dl class="details"><dt>อ้างอิงการรับเงิน</dt><dd>@Model.PaymentReference</dd><dt>ผู้ยืนยันรับเงิน</dt><dd>@(string.IsNullOrEmpty(Model.PaidByName) ? "ระบบกระเป๋าเงิน" : Model.PaidByName)</dd><dt>เวลารับเงิน</dt><dd>@DateTimeOffset.Parse(Model.PaidAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</dd></dl>}
<dl class="details booking-details"><dt>รหัสการจอง</dt><dd class="reference">@Model.Reference</dd><dt>สมาชิก</dt><dd>@Model.MemberName<br/><small>@Model.MemberEmail</small></dd><dt>สนาม</dt><dd>@Model.CourtName</dd><dt>วันที่เล่น</dt><dd>@CourtTime.Display(Model.Date)</dd><dt>เวลา</dt><dd>@Model.TimeLabel · @Model.Hours ชั่วโมง</dd><dt>ราคาที่จอง</dt><dd>฿@CourtTime.Money(Model.PriceSatang) / ชั่วโมง</dd><dt>ยอดก่อนส่วนลด</dt><dd>฿@CourtTime.Money(Model.GrossSatang)</dd><dt>โปรโมชั่น</dt><dd>@Model.PromotionName</dd><dt>ส่วนลด</dt><dd>฿@CourtTime.Money(Model.DiscountSatang)</dd><dt>ยอดสุทธิ</dt><dd class="reference">฿@CourtTime.Money(Model.NetSatang)</dd><dt>สถานะ</dt><dd><span class="pill" data-status="@Model.Status">@Model.StatusLabel</span></dd></dl>
