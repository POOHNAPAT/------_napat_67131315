@model DamageReportForm
<form method="post" asp-controller="Bookings" asp-action="ReportDamage" asp-route-id="" id="general-report-form">
<div asp-validation-summary="All" class="validation alert" role="alert"></div>
<label for="general-category">ประเภทเรื่องที่ต้องการแจ้ง</label><select id="general-category" name="Category"><option value="Other" selected="@(Model.Category=="Other")">ปัญหาทั่วไป / ปัญหาการใช้งานเว็บไซต์</option><option value="Court" selected="@(Model.Category=="Court")">สนามหรือสิ่งอำนวยความสะดวก</option><option value="Equipment" selected="@(Model.Category=="Equipment")">อุปกรณ์กีฬา</option></select>
<label for="general-subject">หัวข้อ / ชื่อสนามหรืออุปกรณ์ (ไม่บังคับ)</label><input id="general-subject" name="Subject" maxlength="200" value="@Model.Subject" placeholder="เช่น สนามฟุตบอล A หรือไม้แบดมินตัน"/>
<label for="general-description">รายละเอียดปัญหา</label><textarea id="general-description" name="Description" rows="6" minlength="5" maxlength="2000" required aria-describedby="general-description-help" placeholder="พิมพ์ปัญหาที่พบ หรืออาการชำรุดที่ต้องการแจ้ง">@Model.Description</textarea><p id="general-description-help" class="help">5–2,000 ตัวอักษร ไม่จำเป็นต้องมีรายการจอง</p><button class="button full" type="submit">ส่งข้อความให้ผู้ดูแล</button></form>
