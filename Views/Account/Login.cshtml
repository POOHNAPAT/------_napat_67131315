@model LoginForm
@{var adminPortal = Context.Items["AdminPortal"] is true; ViewData["Title"]=adminPortal ? "เข้าสู่ระบบผู้ดูแล" : "เข้าสู่ระบบลูกค้า";}
<div class="auth-shell"><aside class="auth-intro"><span class="auth-mark" aria-hidden="true">↗</span><p class="eyebrow">@(adminPortal ? "COURTBOOK MANAGEMENT" : "ยินดีต้อนรับ")</p><h2>@(adminPortal ? "ดูแลทุกสนาม" : "แวะมาเล่น")<br/><span>@(adminPortal ? "ให้พร้อมใช้งาน" : "ด้วยกัน")</span></h2><p>@(adminPortal ? "จัดการสนาม ดูแลสมาชิก และตรวจสอบรายการจองได้ในที่เดียว" : "เลือกสนามและเวลาว่างได้หลังเข้าสู่ระบบ")</p></aside>
<section class="form-panel"><p class="eyebrow">เข้าสู่ระบบ</p><h1>@ViewData["Title"]</h1><p class="muted">@(adminPortal ? "จัดการสนาม ตารางเวลา และรายการจอง" : "เข้าสู่ระบบเพื่อจองสนามและดูรายการของคุณ")</p>
<form method="post" asp-action="Login"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/>
<label asp-for="Email">อีเมล</label><input asp-for="Email" type="email" autocomplete="username" required/>
<label asp-for="Password">รหัสผ่าน</label><input asp-for="Password" type="password" autocomplete="current-password" required/>
<p class="form-bottom"><a asp-action="ForgotPassword">ลืมรหัสผ่าน?</a></p><button class="button full" type="submit">เข้าสู่ระบบ →</button></form>
@if(!adminPortal){<p class="form-bottom">ยังไม่มีบัญชี? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">สมัครสมาชิก</a></p>}</section></div>
