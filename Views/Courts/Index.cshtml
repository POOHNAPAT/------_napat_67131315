@model SchedulePage
@{ViewData["Title"]="สนามและตารางเวลา";var allCourts=(IReadOnlyList<Court>)ViewBag.AllCourts;}
<div class="page-heading"><p class="eyebrow">MAKE TIME FOR YOUR GAME</p><h1>สนามและเวลาว่าง</h1><p>เลือกวันที่ ดูสถานะ แล้วจองช่วงเวลาที่คุณต้องการ</p></div>
<form method="get" class="filter-panel"><div><label for="date">วันที่เล่น</label><input type="date" id="date" name="date" value="@CourtTime.Iso(Model.Date)" min="@CourtTime.Iso(CourtTime.Today)" required/></div><div><label for="courtId">สนาม</label><select id="courtId" name="courtId"><option value="">ทุกสนาม</option>@foreach(var c in allCourts){<option value="@c.Id" selected="@(Model.CourtId==c.Id)">@c.Name</option>}</select></div><button class="button" type="submit">ค้นหาเวลาว่าง ↗</button></form>
<p class="help">จองได้เฉพาะวันและเวลาที่ยังมาไม่ถึง โดยอ้างอิงเวลาในประเทศไทย ช่วงเวลาที่เริ่มไปแล้วจะเลือกจองไม่ได้ แม้ยังไม่หมดชั่วโมง</p>
<div asp-validation-summary="All" class="validation"></div>
<div class="section-heading"><h2>@CourtTime.Display(Model.Date)</h2><div class="legend"><span>● ว่าง</span><span class="muted">● ไม่ว่าง / ปิด</span></div></div>
<div data-server-now="@DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()">
@foreach(var row in Model.Courts){<section class="schedule-card photo-schedule"><div class="schedule-overview"><div class="schedule-photo"><partial name="_CourtPhoto" model="row.Court"/></div><div class="section-heading"><div><h2>@row.Court.Name</h2><span class="pill">@row.Court.SportTypeName</span><p class="muted">@row.Court.Description</p></div><strong>฿@CourtTime.Money(row.Court.PriceSatang)<small> / ชม.</small></strong></div></div><div class="slots">@foreach(var slot in row.Slots){if(slot.Status=="Available"){<a class="slot available" data-slot-start="@(CourtTime.Iso(Model.Date)+"T"+CourtTime.Hour(slot.Hour)+":00+07:00")" asp-controller="Bookings" asp-action="Create" asp-route-courtId="@row.Court.Id" asp-route-date="@CourtTime.Iso(Model.Date)" asp-route-hour="@slot.Hour"><strong>@slot.Label</strong><span>ว่าง ↗</span></a>}else{<div class="slot unavailable"><strong>@slot.Label</strong><span>@slot.StatusLabel</span></div>}}</div></section>}
@if(Model.Courts.Count==0){<div class="empty">ไม่พบสนามที่เปิดให้จองในตัวเลือกนี้</div>}

</div>
@section Scripts {<script src="~/js/availability.js" asp-append-version="true"></script>}
