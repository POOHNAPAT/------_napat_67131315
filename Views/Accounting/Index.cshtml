@model CustomerAccountingPage
@{ViewData["Title"]="บัญชีและการชำระเงินของฉัน";var a=Model.Account;}
<div class="accounting-page">
<div class="page-heading"><p class="eyebrow">MY ACCOUNTING</p><h1>บัญชีและการชำระเงินของฉัน</h1><p>ตรวจยอดใช้จ่าย ดาวน์โหลดรายการ และติดตามคำขอคืนเงิน</p></div>
<form method="get" class="filter-panel"><div><label for="from">ตั้งแต่วันที่</label><input type="date" name="from" id="from" value="@CourtTime.Iso(a.From)" required/></div><div><label for="to">ถึงวันที่</label><input type="date" name="to" id="to" value="@CourtTime.Iso(a.To)" required/></div><button class="button">ดูรายการ</button><a class="button secondary" asp-action="Export" asp-route-from="@CourtTime.Iso(a.From)" asp-route-to="@CourtTime.Iso(a.To)">ดาวน์โหลด CSV</a></form>
<div class="stat-grid"><section class="stat-card"><span>ยอดกระเป๋าปัจจุบัน</span><strong>฿@CourtTime.Money(a.WalletBalanceSatang)</strong><a asp-controller="Wallet" asp-action="Index">เติมเงิน / ดูกระเป๋า ↗</a></section><section class="stat-card"><span>ชำระค่าจองในช่วงนี้</span><strong>฿@CourtTime.Money(a.BookingSatang)</strong></section><section class="stat-card"><span>ซื้อแพ็กในช่วงนี้</span><strong>฿@CourtTime.Money(a.MembershipSatang)</strong></section><section class="stat-card"><span>คืนเข้ากระเป๋าในช่วงนี้</span><strong>฿@CourtTime.Money(a.RefundSatang)</strong></section></div>
<section class="panel"><h2>รายการชำระและเติมเงิน</h2><p class="help">ชำระค่าซ่อม ฿@CourtTime.Money(a.DamageSatang) · เติมเงินผ่านธนาคาร ฿@CourtTime.Money(a.TopUpSatang) · เครดิตทดลอง ฿@CourtTime.Money(a.DemoSatang) · วันที่ตามเวลาไทย ยอดกระเป๋าเป็นยอดปัจจุบันทั้งหมด</p><partial name="_AccountingEntries" model="a.Entries"/></section>
<section class="panel" id="refunds"><p class="eyebrow">REFUND REQUEST</p><h2>ขอคืนเงินค่าจองสนาม</h2><p>ขอคืนเต็มยอดได้ก่อนเริ่มเล่น สำหรับรายการที่ชำระแล้วและยังไม่ยกเลิก เมื่อผู้ดูแลอนุมัติ ระบบจะยกเลิกการจองและคืนเงินเข้ากระเป๋า COURTBOOK ใช้จองครั้งต่อไปได้</p><p class="help">คำขอนี้ใช้สำหรับค่าจองสนามรวมอุปกรณ์ ไม่ครอบคลุมแพ็กสมาชิก ส่งได้ 1 คำขอต่อรายการ การคืนเงินเป็นเครดิตในระบบ</p>
@if(Model.RefundableBookings.Count>0){<form asp-action="RequestRefund" method="post" class="accounting-form"><div><label for="bookingId">รายการจองที่ต้องการคืนเงิน</label><select name="BookingId" id="bookingId" required>@foreach(var b in Model.RefundableBookings){<option value="@b.Id">@b.Reference · @b.CourtName · @CourtTime.Display(b.Date) · ฿@CourtTime.Money(b.NetSatang)</option>}</select></div><div><label for="reason">เหตุผลขอคืนเงิน</label><textarea name="Reason" id="reason" required minlength="5" maxlength="500" rows="3"></textarea></div><button class="button" type="submit">ส่งคำขอให้ผู้ดูแล</button></form>}else{<p class="empty">ไม่มีรายการจองที่สามารถส่งคำขอได้</p>}
<h3>ประวัติคำขอทั้งหมด</h3>@if(Model.Refunds.Count==0){<p>ยังไม่มีคำขอคืนเงิน</p>}else{<p class="accounting-table-hint help">เลื่อนตารางแนวนอนเพื่อดูผลตรวจสอบ →</p><div class="table-wrap" tabindex="0" role="region" aria-label="ประวัติคืนเงิน"><table><thead><tr><th>คำขอ / การจอง</th><th>ยอดคืน</th><th>เหตุผล</th><th>ผลตรวจสอบ</th></tr></thead><tbody>@foreach(var r in Model.Refunds){<tr><td>@r.Reference<br/><a asp-controller="Bookings" asp-action="Result" asp-route-id="@r.BookingId">CB@(r.BookingId.ToString("000000")) · @r.CourtName</a></td><td>฿@CourtTime.Money(r.AmountSatang)</td><td>@r.Reason</td><td><strong>@r.StatusLabel</strong><br/>@r.AdminNote</td></tr>}</tbody></table></div>}</section>

</div>
