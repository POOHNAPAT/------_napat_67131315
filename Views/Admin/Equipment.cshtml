@model IReadOnlyList<RentalEquipment>
@{ViewData["Title"]="อุปกรณ์เสริม";}
<div class="page-heading"><p class="eyebrow">RENTAL EQUIPMENT</p><h1>อุปกรณ์เสริม</h1><p>กำหนดอุปกรณ์แยกตามประเภทกีฬา ลูกค้าจะเห็นเฉพาะอุปกรณ์ที่เปิดให้เช่าของกีฬาที่จอง</p></div>
<p><a class="button" asp-action="EquipmentItem">เพิ่มอุปกรณ์ →</a></p>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>กีฬา</th><th>อุปกรณ์</th><th>ค่าเช่าต่อครั้ง</th><th>สถานะ</th><th></th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.SportTypeName</td><td>@item.Name</td><td>฿@CourtTime.Money(item.PriceSatang) / @item.Unit</td><td>@(item.IsActive ? "เปิดให้เช่า" : "ปิดให้เช่า")</td><td><a asp-action="EquipmentItem" asp-route-id="@item.Id">แก้ไข</a></td></tr>}
</tbody></table></div>@if(Model.Count == 0){<p class="empty">ยังไม่มีอุปกรณ์ เพิ่มอุปกรณ์และเลือกประเภทกีฬาเพื่อเริ่มให้เช่า</p>}</section>
<p class="help">ตัวอย่างอุปกรณ์: ฟุตบอล — ลูกฟุตบอล เสื้อแบ่งทีม · เทนนิส — ไม้เทนนิส ชุดลูกเทนนิส · แบดมินตัน — ไม้แบดมินตัน รองเท้ากีฬา</p>
