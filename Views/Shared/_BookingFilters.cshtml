@model BookingListPage
<form method="get" class="filter-panel"><div><label for="date">วันที่เล่น</label><input id="date" type="date" name="date" value="@(Model.Date.HasValue?CourtTime.Iso(Model.Date.Value):"")"/></div><div><label for="status">สถานะ</label><select id="status" name="status"><option value="">ทุกสถานะ</option><option value="Cancelled" selected="@(Model.Status=="Cancelled")">ยกเลิกแล้ว</option><option value="Pending" selected="@(Model.Status=="Pending")">รอผู้ดูแลยืนยัน</option><option value="Confirmed" selected="@(Model.Status=="Confirmed")">ยืนยันแล้ว</option><option value="Completed" selected="@(Model.Status=="Completed")">เสร็จสิ้น</option></select></div>
@if(Model.Courts.Count>0){<div><label for="courtId">สนาม</label><select id="courtId" name="courtId"><option value="">ทุกสนาม</option>@foreach(var c in Model.Courts){<option value="@c.Id" selected="@(Model.CourtId==c.Id)">@c.Name</option>}</select></div>}
<button class="button" type="submit">ค้นหา</button><a asp-action="@ViewContext.RouteData.Values["action"]">ล้างตัวกรอง</a></form><div asp-validation-summary="All" class="validation"></div>
