@model IReadOnlyList<Court>
@{ViewData["Title"]="จองสนามกีฬาออนไลน์";var featured=Model.FirstOrDefault(c=>c.ImageUrl is not null)??Model.FirstOrDefault();}
<section class="hero">
<div class="hero-copy"><p class="hero-kicker"><span class="live-dot"></span> YOUR NEXT GAME, YOUR WAY</p><h1>เวลาของคุณ<br/>สนามของ<span>ทุกเกม.</span></h1><p class="lead">เลือกสนามที่ชอบ นัดเวลาที่ใช่<br/>แล้วชวนเพื่อนออกมาเล่นด้วยกัน</p><div class="hero-actions"><a class="button" asp-controller="Courts" asp-action="Index">ค้นหาสนามและเวลาว่าง <span>↗</span></a><a class="inline-link" href="#how-to-book">จองอย่างไร <span>↓</span></a></div><div class="hero-facts"><div><strong>@Model.Count<span> สนาม</span></strong><span>พร้อมให้คุณเลือก</span></div><div><strong>08:00–22:00</strong><span>เปิดให้บริการทุกวัน</span></div></div></div>
<div class="hero-art hero-court-photo">
@if(featured is not null){<partial name="_CourtPhoto" model="featured"/>}else{<div class="court-photo-placeholder"><span class="photo-court-lines" aria-hidden="true"></span></div>}
<div class="hero-photo-top"><span class="photo-live"><span class="live-dot"></span> YOUR NEXT GAME STARTS HERE</span><span class="photo-number">01 / COURTBOOK</span></div>
<div class="hero-photo-bottom"><div><span>@(featured?.SportTypeName??"SPORTS CLUB")</span><h2>@(featured?.Name??"พื้นที่สำหรับเกมของคุณ")</h2><p>เลือกสนามที่ใช่ แล้วมาเล่นด้วยกัน</p></div><a class="photo-arrow" asp-controller="Courts" asp-action="Index" asp-route-courtId="@featured?.Id" aria-label="ดูสนามและเวลาว่าง">↗</a></div></div>
</section>
<form method="get" asp-controller="Courts" asp-action="Index" class="quick-book"><div class="quick-book-title"><span class="quick-book-icon" aria-hidden="true">↗</span><div><strong>เกมถัดไปเริ่มที่นี่</strong><small>เลือกสนามและวันที่ แล้วดูเวลาว่าง</small></div></div><div><label for="home-court">สนามที่อยากเล่น</label><select id="home-court" name="courtId"><option value="">ทุกสนามกีฬา</option>@foreach(var court in Model){<option value="@court.Id">@court.Name · @court.SportTypeName</option>}</select></div><div><label for="home-date">วันที่เล่น</label><input id="home-date" name="date" type="date" min="@CourtTime.Iso(CourtTime.Today)" value="@CourtTime.Iso(CourtTime.Today.AddDays(1))" required/></div><button class="button" type="submit">ค้นหาเวลาว่าง <span>↗</span></button></form>
<section class="section"><div class="section-heading"><div><p class="eyebrow">FIND YOUR PLAY</p><h2>สนามที่ใช่ สำหรับเกมของคุณ</h2><p class="muted">ดูบรรยากาศ เลือกสนาม แล้วเช็กเวลาได้เลย</p></div><a class="inline-link" asp-controller="Courts" asp-action="Index">ดูทั้งหมด @Model.Count สนาม ↗</a></div>
<div class="court-grid">@foreach(var court in Model.Take(4)) {
<article class="court-card photo-card"><a class="court-visual" asp-controller="Courts" asp-action="Index" asp-route-courtId="@court.Id"><partial name="_CourtPhoto" model="court"/><span class="photo-sport">@court.SportTypeName</span><span class="photo-card-arrow" aria-hidden="true">↗</span></a><div class="court-info"><div><p class="eyebrow">FIND YOUR PLAY</p><h3>@court.Name</h3><p>@court.Description</p></div><div class="price"><small>ราคา / ชั่วโมง</small>฿@CourtTime.Money(court.PriceSatang)</div></div><a class="card-link" asp-controller="Courts" asp-action="Index" asp-route-courtId="@court.Id"><span><span class="availability-dot"></span> ดูช่วงเวลาว่าง</span><span>เลือกสนามนี้ ↗</span></a></article>
}</div>@if(Model.Count==0){<div class="empty">ขณะนี้ยังไม่มีสนามเปิดให้จอง กรุณาติดต่อผู้ดูแลระบบ</div>}</section>
<section id="how-to-book" class="section booking-guide"><div class="section-heading"><div><p class="eyebrow">LESS PLANNING. MORE PLAYING.</p><h2>พร้อมเล่นใน 3 ขั้นตอน</h2></div><p class="muted">เรื่องจองให้เป็นเรื่องง่าย</p></div><div class="guide-grid"><article><span>01</span><h3>เลือกสนามที่ชอบ</h3><p>ดูรูปสนาม ประเภทกีฬา และราคาก่อนเลือก</p></article><article><span>02</span><h3>เลือกเวลาที่ใช่</h3><p>เลือกชั่วโมงต่อเนื่อง พร้อมดูยอดและโปรโมชั่น</p></article><article><span>03</span><h3>ส่งคำขอ แล้วติดตาม</h3><p>ตรวจสถานะการยืนยันและการรับเงินในรายการจอง</p></article></div></section>
<section class="promo-banner"><div><p class="eyebrow">MORE PLAY. MORE VALUE.</p><h2>เกมสนุกขึ้น<br/>เมื่อจองได้คุ้มกว่า</h2><p>เช็กโปรโมชั่นสมาชิก แล้วเลือกสิทธิ์ที่เหมาะกับเกมของคุณ</p></div><a class="button light" asp-action="Promotions">ดูโปรโมชั่น <span>↗</span></a><span class="promo-decoration" aria-hidden="true">%</span></section>
