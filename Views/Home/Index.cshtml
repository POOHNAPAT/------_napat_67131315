@model IReadOnlyList<Court>
@{
    ViewData["Title"]="ทุกเกม เริ่มที่นี่";
    var featured=Model.FirstOrDefault(c=>c.ImageUrl is not null)??Model.FirstOrDefault();
    var sports=Model.GroupBy(c=>new { c.SportTypeId,c.SportTypeName }).ToList();
}
<section class="hero game-hero">
<div class="hero-copy"><p class="hero-kicker">BOOK YOUR COURT. OWN YOUR GAME.</p><h1>จองสนามกีฬา<br/><span>ง่ายในไม่กี่คลิก</span></h1><p class="lead">เกมดี ๆ เริ่มจากการนัดกัน<br/>เลือกสนาม จองเวลา แล้วเจอกันในสนาม</p>
<div class="hero-actions"><a class="button" asp-controller="Courts" asp-action="Index">ค้นหาสนาม</a><a class="button secondary" asp-controller="Bookings" asp-action="Create">จองสนามเลย</a></div>
<div class="hero-facts"><div><strong>@Model.Count</strong><span>สนามให้เลือก</span></div><div><strong>@sports.Count</strong><span>ประเภทกีฬา</span></div><div><strong>08–22<span> น.</span></strong><span>เปิดทุกวัน</span></div></div></div>
<div class="hero-art hero-court-photo">
@if(featured is not null){<partial name="_CourtPhoto" model="featured"/>}else{<div class="court-photo-placeholder"><span class="photo-court-lines" aria-hidden="true"></span></div>}
<div class="hero-photo-top"><span class="hero-image-label">THE COURT IS CALLING</span><span class="hero-sport-tag">@(featured?.SportTypeName??"COURTBOOK")</span></div>
<div class="hero-photo-bottom"><div><span>สนามสำหรับเกมถัดไปของคุณ</span><h2>@(featured?.Name??"พร้อมเมื่อคุณพร้อม")</h2>@if(featured is not null){<p>฿@CourtTime.Money(featured.PriceSatang) <span>/ ชั่วโมง</span></p>}</div><a class="button secondary" asp-controller="Courts" asp-action="Index" asp-route-courtId="@featured?.Id">ดูสนาม</a></div><span class="hero-side-word" aria-hidden="true">PLAY.</span></div>
</section>
<form method="get" asp-controller="Courts" asp-action="Index" class="quick-book">
<div class="quick-book-title"><span class="quick-book-icon" aria-hidden="true">▦</span><div><strong>เกมถัดไปของคุณ</strong><small>เริ่มจากสนามและวันที่อยากเล่น</small></div></div>
<div><label for="home-court">เลือกสนาม</label><select id="home-court" name="courtId"><option value="">ทุกสนามกีฬา</option>@foreach(var court in Model){<option value="@court.Id">@court.Name · @court.SportTypeName</option>}</select></div>
<div><label for="home-date">วันที่ลงสนาม</label><input id="home-date" name="date" type="date" min="@CourtTime.Iso(CourtTime.Today)" value="@CourtTime.Iso(CourtTime.Today.AddDays(1))" required/></div><button class="button" type="submit">เช็กเวลาว่าง</button></form>
<section class="section sport-category-section"><div class="section-heading"><div><p class="eyebrow">เลือกเกมของคุณ</p><h2>สามกีฬา ทุกสไตล์การเล่น</h2></div></div><div class="sport-category-grid">
@foreach(var category in new[]{("badminton","แบดมินตัน"),("football","ฟุตบอล"),("tennis","เทนนิส")}){var courts=Model.Where(c=>SportsAssets.Key(c.SportTypeName)==category.Item1).ToList();<a class="sport-category-card" asp-controller="Courts" asp-action="Index" asp-route-sport="@category.Item1"><img src="/images/sports/@(category.Item1).png" alt="ภาพประกอบสนาม@(category.Item2)" loading="lazy"/><div><h3>สนาม@(category.Item2)</h3><p>@courts.Count สนาม @(courts.Count>0?$"· เริ่ม ฿{CourtTime.Money(courts.Min(c=>c.PriceSatang))}/ชม.":"· ดูสนามที่เปิดให้บริการ")</p><span>ค้นหาเวลาว่าง</span></div></a>}
</div></section>
<section class="section courts-discovery" id="our-courts">
<div class="section-heading"><div><p class="eyebrow">FIND YOUR PLAYGROUND</p><h2>สนามที่ใช่ เกมที่ชอบ</h2><p class="muted">เลือกกีฬาของคุณ แล้วดูสนามและราคาก่อนจอง</p></div><a class="inline-link" asp-controller="Courts" asp-action="Index">ดูตารางเวลาทุกสนาม</a></div>
<div class="sport-filters" role="group" aria-label="กรองสนามตามกีฬา"><button type="button" class="sport-filter" data-sport="all" aria-pressed="true">ทุกกีฬา <span>@Model.Count</span></button>@foreach(var sport in sports){<button type="button" class="sport-filter" data-sport="@sport.Key.SportTypeId" aria-pressed="false">@sport.Key.SportTypeName <span>@sport.Count()</span></button>}</div>
<div class="court-grid" id="featured-courts">@foreach(var court in Model){
<article class="court-card photo-card" data-court-sport="@court.SportTypeId"><a class="court-visual" asp-controller="Courts" asp-action="Index" asp-route-courtId="@court.Id"><partial name="_CourtPhoto" model="court"/><span class="photo-sport">@court.SportTypeName</span></a><div class="court-info"><div><p class="court-card-kicker">YOUR NEXT MATCH</p><h3>@court.Name</h3><p>@court.Description</p><p class="court-rating">@(court.Rating.HasValue?$"★ {court.Rating:0.0} ({court.ReviewCount} รีวิว)":"ยังไม่มีรีวิว")</p></div><div class="price"><small>บาท / ชั่วโมง</small>฿@CourtTime.Money(court.PriceSatang)</div></div><a class="card-link" asp-controller="Courts" asp-action="Details" asp-route-id="@court.Id"><span>ดูเวลาว่างและอุปกรณ์</span><span class="card-link-label">ดูรายละเอียด</span></a></article>
}</div><p id="court-filter-status" class="help" role="status">แสดง @Model.Count สนาม</p>@if(Model.Count==0){<div class="empty">ยังไม่มีสนามเปิดให้จองในขณะนี้ กรุณาติดต่อผู้ดูแลระบบ</div>}</section>
<section id="how-to-book" class="section game-plan"><div class="plan-intro"><p class="eyebrow">LESS PLANNING. MORE PLAYING.</p><h2>นัดให้ลงตัว<br/><span>แล้วไปเล่นกัน</span></h2><p class="muted">จองสนาม เช่าอุปกรณ์ และตรวจสถานะ<br/>ครบใน COURTBOOK</p><a class="button secondary" asp-controller="Bookings" asp-action="Create">เริ่มจองสนาม</a></div>
<ol class="plan-timeline"><li><span class="plan-marker" aria-hidden="true">✓</span><div><h3>เลือกสนามที่ชอบ</h3><p>ดูประเภทกีฬา รูปสนาม และราคาต่อชั่วโมง</p></div></li><li><span class="plan-marker" aria-hidden="true">▦</span><div><h3>ล็อกเวลาให้ทีม</h3><p>เลือกชั่วโมงต่อเนื่อง เพิ่มอุปกรณ์ของกีฬานั้น และตรวจยอดรวม</p></div></li><li><span class="plan-marker" aria-hidden="true">◎</span><div><h3>ชำระเงินและติดตาม</h3><p>เติมเงินและชำระผ่านกระเป๋าในเว็บ แล้วติดตามการยืนยันในรายการจอง</p></div></li></ol></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">โปรโมชั่น</p><h2>เล่นให้คุ้มขึ้นทุกครั้ง</h2></div><a class="inline-link" asp-action="Promotions">ดูโปรโมชั่นทั้งหมด</a></div><div class="promotion-grid">@foreach(var promo in ((IReadOnlyList<Promotion>)ViewBag.Promotions).Take(3)){<article class="promotion-card"><span class="pill">@promo.DiscountLabel</span><h3>@promo.Name</h3><p>@promo.Condition</p><a asp-controller="Bookings" asp-action="Create" asp-route-promotionId="@promo.Id">เลือกใช้โปรโมชั่น</a></article>}</div><p class="help">มีส่วนลดสมาชิกและการจองครั้งแรกตามเงื่อนไข สำหรับการจองเป็นกลุ่ม เลือกจำนวนผู้เล่นในหน้าจองเพื่อดูโปรโมชั่นที่ใช้ได้</p></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">แพ็กสมาชิก</p><h2>แพ็กรายเดือนและรายปี</h2><p>ดูราคา ระยะเวลา และส่วนลด ก่อนเลือกแพ็กของคุณ</p></div></div><partial name="_MembershipPlans" model="((IReadOnlyList<MembershipPlan>)ViewBag.Plans)"/></section>
<section class="membership-pitch"><div><p class="eyebrow">MAKE IT A ROUTINE</p><h2>เล่นให้ต่อเนื่อง<br/><span>คุ้มขึ้นด้วยแพ็กสมาชิก</span></h2><p>ดูแพ็กรายเดือนและรายปี พร้อมสิทธิ์ส่วนลดค่าจอง<br/>ตรวจราคาและเงื่อนไขก่อนเลือกแพ็กที่เหมาะกับคุณ</p><div class="hero-actions"><a class="button" asp-controller="Home" asp-action="Membership">ดูแพ็กสมาชิก</a><a class="inline-link" asp-action="Promotions">ดูโปรโมชั่นทั้งหมด</a></div></div><div class="membership-art" aria-hidden="true"><span>COURTBOOK / CLUB</span><strong>MORE<br/>GAME.<br/><em>MORE YOU.</em></strong><span>SHOW UP. PLAY AGAIN.</span></div></section>
@section Scripts {<script src="~/js/home.js" asp-append-version="true"></script>}
