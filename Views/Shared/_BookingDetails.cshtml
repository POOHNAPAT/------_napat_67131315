@model Booking
@if(Model.CheckOut is { } departure){<div class="checkin-history"><strong>เช็กเอาต์แล้ว · รับคืนอุปกรณ์ครบ</strong><p>@DateTimeOffset.Parse(departure.CheckedOutAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture) น. · ผู้ตรวจ @departure.StaffName</p></div>}
else if(Model.OutstandingEquipment>0){<p class="alert">@(Model.Ends<=CourtTime.Now?"หมดเวลา · รอคืนอุปกรณ์":"อุปกรณ์อยู่กับลูกค้า") · ค้างคืน @Model.OutstandingEquipment ชิ้น</p>}
else if(Model.CheckIn is not null&&Model.Ends<=CourtTime.Now){<p class="alert">หมดเวลา · รอผู้ดูแลตรวจสอบและยืนยันเช็กเอาต์</p>}
@if(Model.CheckIn is { } entry){<div class="checkin-history"><strong>เช็กอินแล้ว</strong><p>@DateTimeOffset.Parse(entry.CheckedInAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture) น. · ผู้ตรวจ @entry.StaffName</p></div>}
@if(Model.CancelledAt is not null){<p class="help">ลูกค้ายกเลิกเมื่อ @DateTimeOffset.Parse(Model.CancelledAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p>}
@if(Model.IncludedHours>0){<p class="alert success">ใช้โควตาแพ็ก @Model.IncludedHours ชั่วโมงสนาม · รวมอยู่ในยอดส่วนลดแล้ว</p>}
<p><span class="pill">@Model.PaymentStatusLabel</span></p>
@if(Model.PaymentSubmittedAt is not null){<p class="help">แจ้งโอน: @Model.TransferReference · @DateTimeOffset.Parse(Model.PaymentSubmittedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p><a class="inline-link" asp-controller="@(Context.Items["AdminPortal"] is true?"Admin":"Bookings")" asp-action="PaymentSlip" asp-route-id="@Model.Id" target="_blank" rel="noopener">ดูหลักฐานโอน ↗</a>}
@if(Model.ConfirmedAt is not null){<p class="help">ยืนยันการจองโดย @Model.ConfirmedByName · @DateTimeOffset.Parse(Model.ConfirmedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</p>}
@if(Model.PaidAt is not null){<dl class="details"><dt>อ้างอิงการรับเงิน</dt><dd>@Model.PaymentReference</dd><dt>ผู้ยืนยันรับเงิน</dt><dd>@(string.IsNullOrEmpty(Model.PaidByName) ? (Model.NetSatang==0&&Model.IncludedHours>0?"ระบบโควตาแพ็ก":"ระบบกระเป๋าเงิน") : Model.PaidByName)</dd><dt>เวลารับเงิน</dt><dd>@DateTimeOffset.Parse(Model.PaidAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) น.</dd></dl>}
<dl class="details booking-details"><dt>รหัสการจอง</dt><dd class="reference">@Model.Reference</dd><dt>สมาชิก</dt><dd>@Model.MemberName<br/><small>@Model.MemberEmail</small></dd><dt>สนาม</dt><dd>@Model.CourtName</dd><dt>ประเภทกีฬา</dt><dd>@(string.IsNullOrEmpty(Model.SportTypeName)?"ไม่ระบุ (รายการเดิม)":Model.SportTypeName)</dd><dt>ค่าเช่าสนาม</dt><dd>฿@CourtTime.Money(Model.GrossSatang-Model.EquipmentSatang)</dd><dt>ผู้เล่น</dt><dd>@Model.Players คน</dd><dt>วันที่เล่น</dt><dd>@CourtTime.Display(Model.Date)</dd><dt>เวลา</dt><dd>@Model.TimeLabel · @Model.Hours ชั่วโมง</dd><dt>ราคาที่จอง</dt><dd>฿@CourtTime.Money(Model.PriceSatang) / ชั่วโมง</dd><dt>อุปกรณ์เสริม</dt><dd>@if(Model.Equipment.Count == 0){<span>ไม่เช่าอุปกรณ์</span>}else{foreach(var item in Model.Equipment){<div>@item.Name × @item.Quantity @item.Unit · ฿@CourtTime.Money(item.TotalSatang)</div>}}</dd><dt>ค่าเช่าอุปกรณ์</dt><dd>฿@CourtTime.Money(Model.EquipmentSatang)</dd><dt>ยอดก่อนส่วนลด</dt><dd>฿@CourtTime.Money(Model.GrossSatang)</dd><dt>โปรโมชั่น</dt><dd>@Model.PromotionName</dd><dt>ส่วนลด</dt><dd>฿@CourtTime.Money(Model.DiscountSatang)</dd><dt>ยอดสุทธิ</dt><dd class="reference">฿@CourtTime.Money(Model.NetSatang)</dd><dt>สถานะ</dt><dd><span class="pill" data-status="@Model.Status">@Model.StatusLabel</span></dd></dl>
