@model IReadOnlyList<TopUp>
@{ViewData["Title"]="ตรวจคำขอเติมเงิน";}
<div class="page-heading"><p class="eyebrow">WALLET TOP UPS</p><h1>ตรวจคำขอเติมเงิน</h1><p>ตรวจรายการรับเงินจริงในบัญชีธนาคาร ชื่อผู้โอน ยอด และเลขรายการให้ตรงกับสลิปก่อนอนุมัติ</p></div>
<details class="panel"><summary>วิธีตรวจและอนุมัติการเติมเงิน</summary><ol><li>เปิดสลิปของรายการ TU แล้วตรวจยอดและเลขรายการโอน</li><li>ตรวจสอบในบัญชีธนาคารว่ามีเงินเข้าจริงตรงกับรายการ ไม่ใช้รูปสลิปเพียงอย่างเดียวในการยืนยัน</li><li>ถ้ารายการถูกต้อง กด “ตรวจแล้ว อนุมัติ” ระบบจะเพิ่มยอดเข้ากระเป๋าของลูกค้าและบันทึกประวัติ</li><li>ถ้าข้อมูลไม่ถูกต้อง ให้ระบุเหตุผลก่อนกด “ไม่อนุมัติ” ลูกค้าจะเห็นเหตุผลในหน้าคำขอเติมเงิน</li></ol><p class="help">รายการที่ตรวจแล้วจะอนุมัติซ้ำไม่ได้ การเติมเงินเข้ากระเป๋ายังไม่ถือเป็นการชำระค่าจอง ลูกค้าต้องเลือกชำระจากกระเป๋าเงินในรายการจองอีกครั้ง</p></details>
@if(Model.Count==0){<div class="empty">ยังไม่มีคำขอเติมเงิน</div>}
@foreach(var t in Model){<section class="panel"><h2>TU@(t.Id.ToString("000000")) · @t.MemberName</h2><p>ยอด ฿@CourtTime.Money(t.AmountSatang)</p><p><span class="pill">@t.StatusLabel</span> @t.ReviewNote</p><a class="button secondary" asp-action="TopUpSlip" asp-route-id="@t.Id" target="_blank" rel="noopener">เปิดสลิป</a>
@if(t.Status=="Pending"){
<form asp-action="ReviewTopUp" asp-route-id="@t.Id" method="post" onsubmit="return confirm('ยืนยันว่าตรวจรายการรับเงินจริงแล้ว และอนุมัติยอดเติมเงินนี้?');"><input type="hidden" name="approve" value="true"/><button class="button" type="submit">ตรวจแล้ว อนุมัติ ฿@CourtTime.Money(t.AmountSatang)</button></form>
<form asp-action="ReviewTopUp" asp-route-id="@t.Id" method="post"><input type="hidden" name="approve" value="false"/><label for="note-@t.Id">เหตุผลไม่อนุมัติ</label><input id="note-@t.Id" name="note" maxlength="200" required/><button class="button secondary" type="submit">ไม่อนุมัติ</button></form>
}</section>}
