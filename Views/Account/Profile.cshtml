@model SiteUser
@{ViewData["Title"]="บัญชีของฉัน";}
<section class="form-panel"><p class="eyebrow">MY ACCOUNT</p><h1>บัญชีของฉัน</h1><p><a class="button secondary" asp-action="EditProfile">แก้ไขข้อมูลส่วนตัว</a></p><dl class="details"><dt>ชื่อ</dt><dd>@Model.Name</dd><dt>อีเมล</dt><dd>@Model.Email</dd><dt>บทบาท</dt><dd>@(Model.Role=="Admin"?"ผู้ดูแลระบบ":"สมาชิก")</dd></dl><div class="action-group action-grid" role="group" aria-label="จัดการบัญชี"><a class="button" asp-controller="@(Model.Role=="Admin"?"Admin":"Bookings")" asp-action="@(Model.Role=="Admin"?"Customers":"History")">@(Model.Role=="Admin"?"บัญชีลูกค้า":"ประวัติการจอง")</a>@if(Model.Role=="Member"){<a class="button secondary" asp-controller="Wallet" asp-action="Index">กระเป๋าเงิน</a><a class="button secondary" asp-controller="Home" asp-action="Membership">แพ็กสมาชิก</a><a class="button secondary" asp-controller="Accounting" asp-action="Index">บัญชีและการชำระเงิน</a><a class="button secondary" asp-controller="Receipts" asp-action="Index">ใบเสร็จของฉัน</a><a class="button secondary" asp-controller="Bookings" asp-action="ReportDamage">แจ้งปัญหา / ติดต่อผู้ดูแล</a>}</div></section>
