@model EquipmentHandoverPage
@{var admin=Context.Items["AdminPortal"] is true;ViewData["Title"]="รับ–คืนอุปกรณ์ · "+Model.Booking.Reference;}
<div class="page-heading"><h1>@(admin?"รับ–คืนอุปกรณ์":"สถานะรับ–คืนอุปกรณ์")</h1><p>@Model.Booking.Reference · @Model.Booking.CourtName · @CourtTime.Display(Model.Booking.Date) · @Model.Booking.TimeLabel</p><p>@Model.Booking.MemberName</p><a asp-controller="@(admin?"Admin":"Bookings")" asp-action="@(admin?"Booking":"Result")" asp-route-id="@Model.Booking.Id">กลับรายละเอียดการจอง</a>@if(admin){<span> · </span><a asp-action="Inventory">ดูสต็อกและอุปกรณ์ค้างคืน</a>}</div>
@if(admin){<p class="help">ส่งมอบได้ในช่วงเวลาเล่น เมื่อยืนยันการจองและชำระแล้ว รับคืนแยกจำนวนปกติกับชำรุดได้ และเก็บรูปสภาพก่อน–หลังไว้เป็นหลักฐาน</p>}
@if(Model.Loans.Count==0){<section class="panel"><p class="empty">รายการจองนี้ไม่มีอุปกรณ์ให้รับ–คืน</p></section>}
<div class="inventory-loan-grid">
@foreach(var loan in Model.Loans){<section class="panel" id="loan-@loan.EquipmentId"><div class="section-heading"><h2>@loan.Name</h2><span class="pill">@loan.StatusLabel</span></div>
<dl class="inventory-counts"><dt>จองไว้</dt><dd>@loan.ReservedQuantity @loan.Unit</dd><dt>ส่งมอบแล้ว</dt><dd>@loan.IssuedQuantity @loan.Unit</dd><dt>รับคืนปกติ</dt><dd>@loan.GoodQuantity @loan.Unit</dd><dt>รับคืนชำรุด</dt><dd>@loan.DamagedQuantity @loan.Unit</dd><dt>ลูกค้ายังถืออยู่</dt><dd><strong>@loan.Outstanding @loan.Unit</strong></dd></dl>
@if(admin&&loan.CanIssue){<details class="inventory-action"><summary>ส่งมอบอุปกรณ์ให้ลูกค้า</summary><form method="post" asp-action="IssueEquipment" asp-route-id="@loan.BookingId" enctype="multipart/form-data"><input type="hidden" name="EquipmentId" value="@loan.EquipmentId"/><input type="hidden" name="Revision" value="@loan.Revision"/><label for="issue-quantity-@loan.EquipmentId">จำนวนส่งมอบ (@loan.Unit)</label><input id="issue-quantity-@loan.EquipmentId" name="Quantity" type="number" min="1" max="@loan.Unissued" step="1" value="@loan.Unissued" required/>
<label for="issue-note-@loan.EquipmentId">สภาพก่อนส่งมอบ / หมายเหตุ</label><textarea id="issue-note-@loan.EquipmentId" name="Note" rows="3" minlength="5" maxlength="1000" required></textarea><label for="issue-image-@loan.EquipmentId">รูปก่อนส่งมอบ (ไม่บังคับ)</label><input id="issue-image-@loan.EquipmentId" name="Image" type="file" accept="image/jpeg,image/png,image/webp"/><p class="help">JPG, PNG หรือ WebP ไม่เกิน 5 MB</p><button class="button" type="submit">ยืนยันส่งมอบ</button></form></details>}
@if(admin&&loan.Outstanding>0){<details class="inventory-action" open><summary>รับคืนและตรวจสภาพ</summary><form method="post" asp-action="ReturnEquipment" asp-route-id="@loan.BookingId" enctype="multipart/form-data"><input type="hidden" name="EquipmentId" value="@loan.EquipmentId"/><input type="hidden" name="Revision" value="@loan.Revision"/>
<div class="form-grid"><div><label for="return-good-@loan.EquipmentId">คืนสภาพปกติ (@loan.Unit)</label><input id="return-good-@loan.EquipmentId" name="GoodQuantity" type="number" min="0" max="@loan.Outstanding" step="1" value="@loan.Outstanding" required/></div><div><label for="return-damaged-@loan.EquipmentId">คืนชำรุด (@loan.Unit)</label><input id="return-damaged-@loan.EquipmentId" name="DamagedQuantity" type="number" min="0" max="@loan.Outstanding" step="1" value="0" required/></div></div>
<p class="help">จำนวนปกติรวมชำรุดต้องไม่เกิน @loan.Outstanding @loan.Unit สามารถรับคืนบางส่วนได้ ของชำรุดจะพักไว้รอซ่อมและเปิดรายงานให้ตรวจสอบค่าเสียหาย</p>
<label for="return-note-@loan.EquipmentId">ผลตรวจสภาพ / หมายเหตุ</label><textarea id="return-note-@loan.EquipmentId" name="Note" rows="3" minlength="5" maxlength="1000" required></textarea><label for="return-image-@loan.EquipmentId">รูปขณะรับคืน (ไม่บังคับ)</label><input id="return-image-@loan.EquipmentId" name="Image" type="file" accept="image/jpeg,image/png,image/webp"/><p class="help">JPG, PNG หรือ WebP ไม่เกิน 5 MB</p><button class="button" type="submit">ยืนยันรับคืนและบันทึกสภาพ</button></form></details>}
</section>}
</div><section class="panel inventory-section"><h2>ประวัติส่งมอบและรับคืน</h2><partial name="_EquipmentMovements" model="Model.Movements"/></section>
