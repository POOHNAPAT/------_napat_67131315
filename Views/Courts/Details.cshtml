@model CourtDetailsPage
@{ViewData["Title"]=Model.Court.Name;}
<div class="page-heading"><p class="eyebrow">รายละเอียดสนาม</p><h1>@Model.Court.Name</h1><p>@Model.Court.SportTypeName</p></div>
<div class="court-detail-grid"><div class="detail-photo"><partial name="_CourtPhoto" model="Model.Court"/></div><section class="panel"><span class="pill">@Model.Court.SportTypeName</span><h2>พร้อมสำหรับเกมของคุณ</h2><p>@Model.Court.Description</p><p class="price">฿@CourtTime.Money(Model.Court.PriceSatang) <small>/ ชั่วโมง</small></p><p>เวลาให้บริการ 08:00–22:00 น.</p><p class="help">@(Model.Court.Rating.HasValue?$"★ {Model.Court.Rating:0.0} จาก {Model.Court.ReviewCount} รีวิวผู้ใช้สนาม":"ยังไม่มีรีวิวจากผู้ใช้สนาม")</p><a class="button full" asp-controller="Bookings" asp-action="Create" asp-route-courtId="@Model.Court.Id">จองสนามนี้</a><p><a asp-action="Index" asp-route-courtId="@Model.Court.Id">ดูตารางเวลาว่าง</a></p></section></div>
<section class="panel"><h2>รีวิวจากผู้ใช้สนาม</h2><p class="help">รีวิวได้หลังใช้สนามจากรายการจองที่ผู้ดูแลยืนยันแล้วเท่านั้น หนึ่งบัญชีให้คะแนนแต่ละสนามได้หนึ่งครั้ง และแก้ไขได้</p>
@foreach(var review in Model.Reviews){<article class="court-review"><strong>@review.MemberName · ★ @review.Rating/5</strong><p>@review.Comment</p><small>@DateTimeOffset.Parse(review.CreatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small></article>}
@if(Model.Reviews.Count==0){<p class="empty">ยังไม่มีรีวิว</p>}
@if(Model.CanReview){<form method="post" asp-action="Review"><input type="hidden" name="CourtId" value="@Model.Court.Id"/><label for="review-rating">คะแนน</label><select id="review-rating" name="Rating">@for(var rating=5;rating>=1;rating--){<option value="@rating">@rating ดาว</option>}</select><label for="review-comment">ความคิดเห็น</label><textarea id="review-comment" name="Comment" maxlength="500" rows="3"></textarea><button class="button" type="submit">บันทึกรีวิว</button></form>}</section>
