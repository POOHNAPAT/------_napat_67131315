@model EquipmentInventoryPage
@{ViewData["Title"]="สต็อกและรับ–คืนอุปกรณ์";}
<div class="page-heading"><h1>สต็อกและรับ–คืนอุปกรณ์</h1><p>ตรวจจำนวนพร้อมใช้ อุปกรณ์ค้างคืน และรายการที่รอซ่อม</p><a class="button secondary" asp-action="Equipment">จัดการรายการอุปกรณ์</a></div>
<section class="panel"><h2>จำนวนอุปกรณ์</h2><p class="help">จำนวนรอซ่อมรวมอยู่ในจำนวนทั้งหมด การจองกันอุปกรณ์ตามช่วงเวลา ส่วนอุปกรณ์เกินกำหนดคืนจะกันไว้จนกว่าจะรับคืนจริง</p>
<div class="table-wrap" tabindex="0" role="region" aria-label="จำนวนสต็อกอุปกรณ์"><table><thead><tr><th>อุปกรณ์</th><th>ทั้งหมด</th><th>รอซ่อม</th><th>ลูกค้าถืออยู่</th><th>พร้อมส่งมอบในคลัง</th><th>จอง / ค้างคืนสูงสุด</th><th>จัดการ</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td><strong>@item.Equipment.Name</strong><br/><small>@item.Equipment.SportTypeName · @item.Equipment.Unit</small>@if(item.ShortageQuantity>0){<p class="validation">จำนวนพร้อมใช้ไม่พอ @item.ShortageQuantity @item.Equipment.Unit กรุณาตรวจรายการจอง</p>}else if(item.TotalQuantity==0){<p class="help">ตรวจนับและตั้งจำนวนก่อนให้เช่า</p>}</td><td>@item.TotalQuantity</td><td>@item.RepairQuantity</td><td>@item.IssuedQuantity</td><td>@item.InStoreQuantity</td><td>@item.PeakReserved</td><td><a asp-action="EquipmentStock" asp-route-id="@item.Equipment.Id">ปรับสต็อก / ซ่อมเสร็จ</a></td></tr>}
</tbody></table></div></section>
<section class="panel inventory-section"><h2>อุปกรณ์ที่ลูกค้ายังไม่คืน</h2>
@if(Model.Outstanding.Count==0){<p class="empty">ไม่มีอุปกรณ์ค้างคืน</p>}else{<div class="table-wrap" tabindex="0" role="region" aria-label="รายการอุปกรณ์ที่ยังไม่คืน"><table><thead><tr><th>การจอง / ลูกค้า</th><th>อุปกรณ์</th><th>ค้างคืน</th><th>กำหนดคืน</th><th>สถานะ</th><th></th></tr></thead><tbody>@foreach(var loan in Model.Outstanding){<tr><td>CB@(loan.BookingId.ToString("000000"))<br/>@loan.MemberName</td><td>@loan.Name</td><td>@loan.Outstanding @loan.Unit</td><td>@CourtTime.Display(loan.Date) · @CourtTime.Hour(loan.StartHour+loan.Hours)</td><td>@loan.StatusLabel</td><td><a asp-action="EquipmentHandover" asp-route-id="@loan.BookingId">รับคืน / ดูประวัติ</a></td></tr>}</tbody></table></div>}
<p><a asp-action="Bookings">เลือกรายการจองเพื่อส่งมอบอุปกรณ์</a></p></section>
<section class="panel inventory-section"><h2>ความเคลื่อนไหวล่าสุด</h2><p class="help">แสดงล่าสุดไม่เกิน 200 รายการ</p><partial name="_EquipmentMovements" model="Model.Movements"/></section>
