@model ForgotPasswordForm
@{ViewData["Title"]="ลืมรหัสผ่าน";}
<section class="form-panel"><p class="eyebrow">กู้คืนบัญชี</p><h1>ลืมรหัสผ่าน?</h1><p class="muted">กรอกอีเมลที่ใช้สมัครสมาชิก เราจะส่งลิงก์ให้ตั้งรหัสผ่านใหม่</p>
@if(ViewBag.Sent is true){<p class="alert success" role="status">หากมีบัญชีที่ใช้อีเมลนี้ ระบบจะส่งลิงก์ให้ กรุณาตรวจกล่องข้อความและจดหมายขยะภายใน 30 นาที</p>}else{
<form method="post"><div asp-validation-summary="All" class="validation alert" role="alert"></div><label asp-for="Email">อีเมล</label><input asp-for="Email" type="email" autocomplete="email" required/>
@if(ViewBag.EmailConfigured is not true){<p class="alert">ระบบส่งอีเมลยังไม่พร้อมใช้งาน กรุณาติดต่อผู้ดูแลเพื่อกู้คืนบัญชี</p>}
<button class="button full" type="submit" disabled="@(ViewBag.EmailConfigured is not true)">ส่งลิงก์ตั้งรหัสผ่านใหม่</button></form>}
<p class="form-bottom"><a asp-action="Login">กลับเข้าสู่ระบบ</a></p></section>
