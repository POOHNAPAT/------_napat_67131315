@model IReadOnlyList<Booking>
@{var admin=ViewContext.RouteData.Values["controller"]?.ToString()=="Admin";}
<div class="table-wrap"><table><thead><tr><th>รายการ</th>@if(admin){<th>สมาชิก</th>}<th>สนาม / วันที่</th><th>เวลา</th><th>ยอดสุทธิ</th><th>สถานะ</th><th></th></tr></thead><tbody>
@foreach(var b in Model){<tr><td class="reference">@b.Reference</td>@if(admin){<td><a asp-action="Customer" asp-route-id="@b.UserId">@b.MemberName</a><br/><small>@b.MemberEmail</small></td>}<td><strong>@b.CourtName</strong><br/><small>@CourtTime.Display(b.Date)</small></td><td>@b.TimeLabel</td><td>฿@CourtTime.Money(b.NetSatang)</td><td><span class="pill @(b.Status=="Completed"?"neutral":"")" data-status="@b.Status">@b.StatusLabel</span><br/><small>@b.PaymentStatusLabel</small></td><td>@if(!admin && b.ApprovalStatus is "Pending" or "Confirmed" && b.PaidAt is null && b.NetSatang>0 && b.PaymentSubmittedAt is null){<a class="button small" asp-controller="Bookings" asp-action="Result" asp-route-id="@b.Id" asp-fragment="qr-payment">ชำระเงินผ่าน QR</a><br/>}@if(b.PaidAt is not null){<a asp-controller="@(admin?"Admin":"Receipts")" asp-action="@(admin?"Receipt":"Details")" asp-route-id="@($"RC-BK-{b.Id:000000}")">ใบเสร็จ</a><br/>}<a asp-controller="@(admin?"Admin":"Bookings")" asp-action="@(admin?"Booking":"Result")" asp-route-id="@b.Id">รายละเอียด ↗</a></td></tr>}
@if(Model.Count==0){<tr><td colspan="7" class="empty">ยังไม่มีรายการจองในตัวเลือกนี้</td></tr>}
</tbody></table></div>
