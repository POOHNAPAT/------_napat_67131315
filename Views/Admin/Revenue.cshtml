@model RevenuePage
@{ViewData["Title"]="รายได้และสถิติการจอง";var highest=Model.Days.Count>0?Math.Max(1,Model.Days.Max(d=>d.PaidSatang)):1;}
<div class="page-heading"><p class="eyebrow">รายงานผู้ดูแล</p><h1>รายได้และสถิติการจอง</h1><p>ตามวันที่ใช้สนาม รายได้รวมเฉพาะรายการที่ยืนยันรับเงินแล้ว รวมค่าอุปกรณ์ ไม่รวมยอดเติมกระเป๋าและการขายแพ็ก และยังไม่หักคืนเงิน</p></div>
<p><a asp-action="Accounting">ดูบัญชีตามวันที่รับชำระและการคืนเงิน ↗</a></p>
<form method="get" class="filter-panel"><div><label for="from">ตั้งแต่วันที่</label><input type="date" id="from" name="from" value="@CourtTime.Iso(Model.From)" required/></div><div><label for="to">ถึงวันที่</label><input type="date" id="to" name="to" value="@CourtTime.Iso(Model.To)" required/></div><button class="button" type="submit">ดูรายงาน</button></form>
<div class="stat-grid"><section class="stat-card"><span>ชำระค่าจองก่อนหักคืนเงิน</span><strong>฿@CourtTime.Money(Model.PaidSatang)</strong></section><section class="stat-card"><span>รอชำระค่าจอง</span><strong>฿@CourtTime.Money(Model.PendingSatang)</strong></section><section class="stat-card"><span>รายการจอง / ยกเลิก</span><strong>@Model.Bookings.Count / @Model.Cancelled</strong></section></div>
<section class="panel"><h2>รายได้แยกตามวันใช้สนาม</h2>@if(Model.Days.Count==0){<p class="empty">ไม่มีรายการจองในช่วงนี้</p>}else{<div class="revenue-chart">@foreach(var day in Model.Days){<div class="revenue-chart-row"><span>@day.Date.ToString("dd/MM")</span><div class="revenue-bar-track"><span style="width:@((day.PaidSatang*100m/highest).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></span></div><strong>฿@CourtTime.Money(day.PaidSatang)</strong><small>@day.Bookings รายการ</small></div>}</div>}</section>
<section class="panel"><h2>รายการในรายงาน</h2><partial name="_BookingTable" model="Model.Bookings"/></section>
