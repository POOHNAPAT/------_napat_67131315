@model AdminSchedulePage
@{ViewData["Title"]="จัดการตารางเวลา";}
<div class="page-heading"><p class="eyebrow">AVAILABILITY</p><h1>จัดการช่วงเวลาสนาม</h1><p>เลือกช่องที่ต้องการปิดให้จอง ช่วงที่มีการจองแล้วจะแก้ไขไม่ได้</p></div>
<form method="get" class="filter-panel"><div><label for="courtId">สนาม</label><select id="courtId" name="courtId">@foreach(var c in Model.Courts){<option value="@c.Id" selected="@(c.Id==Model.Court.Id)">@c.Name</option>}</select></div><div><label for="date">วันที่</label><input id="date" type="date" name="date" value="@CourtTime.Iso(Model.Date)" min="@CourtTime.Iso(CourtTime.Today)" required/></div><button class="button" type="submit">ดูตารางเวลา</button></form>
@if(!Model.Court.IsActive){<p class="alert">สนามนี้ถูกปิดทั้งสนาม หากต้องการเปิดรับจองให้เปลี่ยนสถานะในหน้าจัดการสนามด้วย</p>}
<section class="panel"><div class="section-heading"><h2>@Model.Court.Name · @CourtTime.Display(Model.Date)</h2><span class="help">ทำเครื่องหมาย = ปิดให้จอง</span></div><form method="post" asp-action="Schedule"><input type="hidden" name="courtId" value="@Model.Court.Id"/><input type="hidden" name="date" value="@CourtTime.Iso(Model.Date)"/><div class="table-wrap"><table><thead><tr><th>เวลา</th><th>สถานะ</th><th>ปิดช่วงเวลา</th></tr></thead><tbody>@foreach(var slot in Model.Slots){<tr><td>@slot.Label</td><td><span class="pill @(slot.Status=="Available"?"":"neutral")">@(slot.Status=="Available"?"เปิดให้จอง":slot.StatusLabel)</span></td><td>@if(slot.Status=="Booked"){<a asp-action="Bookings" asp-route-date="@CourtTime.Iso(Model.Date)" asp-route-courtId="@Model.Court.Id">ดูรายการจอง →</a>}else{<input aria-label="ปิดช่วงเวลา @slot.Label" type="checkbox" name="blocked" value="@slot.Hour" checked="@(slot.Status=="Closed")" disabled="@(slot.Status=="Past"||Model.Date<CourtTime.Today)"/>}</td></tr>}</tbody></table></div><button class="button" type="submit">บันทึกการเปลี่ยนแปลง</button></form></section>
