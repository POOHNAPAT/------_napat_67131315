@model DemoPayment
@{ViewData["Title"]="ชำระเงินทดลอง";}
<section class="form-panel">
<p class="eyebrow">COURTBOOK DEMO CHECKOUT</p><h1>ชำระเงินทดลอง</h1>
<p class="alert">หน้านี้จำลองผู้ให้บริการชำระเงิน ไม่มีการเรียกเก็บเงินจริง ไม่ต้องกรอกข้อมูลบัตรหรือโอนเงิน</p>
<dl class="details"><dt>ยอดเครดิตทดลอง</dt><dd><strong>฿@CourtTime.Money(Model.AmountSatang)</strong></dd><dt>รหัสรายการ</dt><dd style="overflow-wrap:anywhere">@Model.Id</dd><dt>สถานะ</dt><dd>@Model.StatusLabel</dd></dl>
@if(Model.Status=="Pending" && !Model.IsExpired){
<p>เลือกผลการชำระเงินเพื่อทดสอบระบบ เมื่อสำเร็จเครดิตจะเข้ากระเป๋าอัตโนมัติ รายการมีอายุ 15 นาที</p>
<form asp-action="CompleteDemoPayment" asp-route-id="@Model.Id" method="post">
<div class="action-row">
<button class="button" type="submit" name="outcome" value="Paid">จำลองชำระสำเร็จ</button>
<button class="button secondary" type="submit" name="outcome" value="Failed">จำลองชำระไม่สำเร็จ</button>
<button class="button secondary" type="submit" name="outcome" value="Cancelled">ยกเลิกรายการทดลอง</button>
</div></form>
}else{<p>รายการนี้สิ้นสุดแล้ว ไม่สามารถเติมเครดิตซ้ำได้ สร้างรายการใหม่ได้จากหน้ากระเป๋าเงิน</p>}
<p><a asp-action="Index" asp-fragment="topup">กลับไปกระเป๋าเงิน</a></p>
</section>
