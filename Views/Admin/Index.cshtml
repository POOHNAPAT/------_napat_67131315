@model AdminOverview
@{ViewData["Title"]="ภาพรวมผู้ดูแล";}
<div class="section-heading page-heading"><div><p class="eyebrow">CLUB OVERVIEW</p><h1>ยินดีต้อนรับ, ผู้ดูแล</h1><p>เริ่มวันด้วยภาพรวมสนามและรายการจองของคุณ</p></div><a class="button" asp-action="Court" asp-route-id="0">+ เพิ่มสนามใหม่</a></div>
<div class="stat-grid"><a class="stat-card" asp-action="Courts"><span>สนามทั้งหมด <span class="stat-symbol" aria-hidden="true">▦</span></span><strong>@Model.Courts<small> สนาม</small></strong><small>จัดการสนามและรูปภาพ ↗</small></a><a class="stat-card" asp-action="Bookings"><span>รายการจองทั้งหมด <span class="stat-symbol" aria-hidden="true">☷</span></span><strong>@Model.Bookings<small> รายการ</small></strong><small>ตรวจสอบและยืนยันรายการ ↗</small></a><a class="stat-card" asp-action="Promotions"><span>โปรโมชั่นทั้งหมด <span class="stat-symbol" aria-hidden="true">◇</span></span><strong>@Model.Promotions<small> โปรโมชั่น</small></strong><small>ดูแลสิทธิ์สมาชิก ↗</small></a></div>
<div class="admin-quick-actions"><a asp-action="Schedule"><span aria-hidden="true">◷</span><div><strong>จัดการเวลาสนาม</strong><small>เปิด–ปิดช่วงเวลาที่ให้จอง</small></div><span aria-hidden="true">↗</span></a><a asp-action="Customers"><span aria-hidden="true">◎</span><div><strong>ดูแลบัญชีลูกค้า</strong><small>ข้อมูลสมาชิกและประวัติการจอง</small></div><span aria-hidden="true">↗</span></a></div>
<section class="panel"><div class="section-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>รายการจองล่าสุด</h2></div><a class="inline-link" asp-action="Bookings">ดูรายการทั้งหมด ↗</a></div><partial name="_BookingTable" model="Model.Recent"/></section>
