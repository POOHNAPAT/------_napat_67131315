@model IReadOnlyList<MembershipPlan>
@{ViewData["Title"]="แพ็กสมาชิก";}
<div class="page-heading"><p class="eyebrow">แพ็กสมาชิก</p><h1>เลือกแพ็กสำหรับเกมของคุณ</h1><p>แพ็กรายเดือนและรายปี ตรวจราคา ระยะเวลา และสิทธิ์ก่อนสมัคร</p></div>
@if(ViewBag.MembershipWallet is WalletPage wallet){<section class="panel"><p>ยอดกระเป๋าเงิน ฿@CourtTime.Money(wallet.BalanceSatang)</p>@if(wallet.Membership is Membership member){<p class="alert success">@member.Name · @(member.MonthlyHours>0?$"{member.MonthlyHours} ชั่วโมง / เดือน · {member.QuotaSportName} · ส่วนเกินลด {member.DiscountPercent}%":$"ลดค่าจอง {member.DiscountPercent}%") · ใช้ได้ถึง @CourtTime.Display(member.Ends.AddDays(-1))</p>}@if(wallet.Membership?.Quotas is {Count:>0} quotas){<h2>ชั่วโมงสนามของฉัน</h2><p class="help">นับตามวันที่เล่น รวมรายการที่จองไว้และยังไม่ยกเลิก รอบใหม่ไม่ทบชั่วโมงที่เหลือจากรอบก่อน</p><div class="table-wrap"><table><thead><tr><th>รอบวันที่เล่น</th><th>ชั่วโมงที่จองใช้แล้ว</th><th>คงเหลือ</th></tr></thead><tbody>@foreach(var q in quotas){<tr><td>@CourtTime.Display(q.Starts) – @CourtTime.Display(q.Ends.AddDays(-1))</td><td>@q.UsedHours / @q.TotalHours ชม.</td><td><strong>@q.RemainingHours ชม.</strong></td></tr>}</tbody></table></div>}
<a class="inline-link" asp-controller="Wallet" asp-action="Index">เติมเงิน / ดูกระเป๋าเงิน</a></section>}
<partial name="_MembershipPlans" model="Model"/>
