@model WalletPage
@{ViewData["Title"]="กระเป๋าเงิน";var checkout=ViewData["Checkout"] as WalletCheckout;var suggested=checkout?.SuggestedAmount(Model.BalanceSatang);}
<div class="page-heading"><p class="eyebrow">WALLET & MEMBERSHIP</p><h1>กระเป๋าเงิน</h1><p>เติมเงินและจัดการยอดสำหรับชำระค่าจอง</p></div>
<p class="action-group"><a class="button secondary" asp-controller="Accounting" asp-action="Index">บัญชีและการชำระเงิน</a><a class="button secondary" asp-controller="Receipts" asp-action="Index">ใบเสร็จของฉัน</a></p>
<div asp-validation-summary="All" class="validation alert" role="alert"></div>
@if(checkout is not null){<section class="panel wallet-checkout" id="checkout-return"><h2>@checkout.Title</h2>@if(checkout.RequiredSatang>0){<p>ยอดรายการ ฿@CourtTime.Money(checkout.RequiredSatang) · ขาดอีก ฿@CourtTime.Money(checkout.MissingSatang(Model.BalanceSatang))</p>}else{<p>รายการนี้ไม่มียอดรอชำระ กรุณากลับไปตรวจสถานะล่าสุดก่อนเติมเงินเพิ่ม</p>}
@if(checkout.MissingSatang(Model.BalanceSatang)>0&&ViewData["DemoTopUpsEnabled"] is true){<p>กรอกยอดเครดิตที่ต้องเติมไว้ให้แล้ว เมื่อเติมสำเร็จให้กลับไปตรวจรายการและยืนยันชำระ</p>@if(checkout.MissingSatang(Model.BalanceSatang)<100){<p class="help">ยอดที่ขาดต่ำกว่า 1 บาท การเติมเครดิตทดลองมีขั้นต่ำ 1 บาท ส่วนที่เหลือเก็บไว้ในกระเป๋า</p>}@if(checkout.MissingSatang(Model.BalanceSatang)>10000000){<p class="help">เติมได้ครั้งละไม่เกิน 100,000 บาท สามารถทยอยเติมจนครบยอดได้</p>}}
else if(checkout.MissingSatang(Model.BalanceSatang)>0){<p>ขณะนี้การเติมเงินยังไม่เปิดให้บริการ กรุณาติดต่อผู้ดูแล</p>}
else{<p>กลับไปตรวจสถานะและยืนยันชำระรายการเดิมได้ ไม่มีการตัดเงินอัตโนมัติจากการเติมเงิน</p>}
<a class="button secondary" href="@checkout.ReturnUrl">กลับไปรายการเดิม / ชำระต่อ</a></section>}
<section class="panel"><p class="eyebrow">YOUR BALANCE</p><h2>ยอดคงเหลือ ฿@CourtTime.Money(Model.BalanceSatang)</h2><p>ใช้ชำระค่าจอง อุปกรณ์ แพ็กสมาชิก และค่าซ่อมที่ยอมรับแล้ว โดยยืนยันชำระในแต่ละรายการ</p>
@if(ViewData["DemoTopUpsEnabled"] is true){<div class="action-row"><a class="button" href="#topup">เติมเงินเข้ากระเป๋า</a></div>}

</section>
@if(ViewData["DemoTopUpsEnabled"] is true){
<section class="panel" id="topup" aria-labelledby="automatic-topup-heading">
<p class="eyebrow">เครดิตทดลอง</p><h2 id="automatic-topup-heading">เติมเครดิตอัตโนมัติแบบทดลอง</h2>
<p class="alert">เครดิตทดลองใช้จองสนามและซื้อแพ็กในระบบได้ โดยรวมอยู่ในยอดกระเป๋า ไม่มีการเรียกเก็บเงินจริง</p>
<ol><li>ระบุยอดเครดิตที่ต้องการเติม</li><li>กด “ไปหน้าชำระเงินทดลอง”</li><li>กด “ชำระสำเร็จ” เพื่อเพิ่มเครดิตทดลองเข้ากระเป๋าทันที ไม่ต้องแนบสลิปหรือรอผู้ดูแล</li></ol>
<form asp-action="StartDemoPayment" asp-route-bookingId="@checkout?.BookingId" asp-route-planId="@checkout?.PlanId" asp-route-damageId="@checkout?.DamageId" method="post">
<label for="demo-amount">ยอดเครดิตทดลอง (บาท)</label><input id="demo-amount" name="Amount" type="number" min="1" max="100000" step="0.01" value="@(suggested>0?Math.Max(1,suggested.Value):100)" required aria-describedby="demo-amount-help"/>
<p class="help" id="demo-amount-help">ครั้งละ 1–100,000 บาท ทศนิยมไม่เกิน 2 ตำแหน่ง</p>
<button class="button" type="submit">ไปหน้าชำระเงินทดลอง</button></form>
</section>
}
else{<section class="panel"><p class="alert">ขณะนี้การเติมเงินยังไม่เปิดให้บริการ กรุณา<a asp-controller="Home" asp-action="Contact">ติดต่อผู้ดูแล</a></p></section>}
@if(Model.TopUps.Count>0){
<section class="panel" id="topup-requests"><h2>ประวัติคำขอเติมเงิน</h2><p class="help">คำขอที่เคยส่งพร้อมหลักฐานจะเพิ่มยอดหลังผู้ดูแลอนุมัติ ระหว่างรอตรวจสอบไม่ต้องส่งคำขอซ้ำ</p>
<div class="table-wrap"><table><thead><tr><th>รายการ / ยอดเติม</th><th>สถานะ</th><th>หลักฐาน / ดำเนินการต่อ</th></tr></thead><tbody>@foreach(var topup in Model.TopUps){<tr><td>TU@(topup.Id.ToString("000000"))<br/>฿@CourtTime.Money(topup.AmountSatang)</td><td>@topup.StatusLabel<br/><small>@topup.ReviewNote</small></td><td><a asp-action="Slip" asp-route-id="@topup.Id" target="_blank" rel="noopener">ดูสลิป</a>@if(WalletCheckout.SafePath(topup.CheckoutPath)){<br/><a href="@topup.CheckoutPath">กลับไปรายการเดิม</a>}</td></tr>}@if(Model.TopUps.Count==0){<tr><td colspan="3">ยังไม่มีคำขอเติมเงิน</td></tr>}</tbody></table></div></section>
}
<section class="panel"><h2>ประวัติกระเป๋าเงิน</h2><div class="table-wrap"><table><thead><tr><th>เวลา</th><th>รายการ</th><th>ยอดเงินเข้า / ออก</th></tr></thead><tbody>
@foreach(var e in Model.Entries){<tr><td>@DateTimeOffset.Parse(e.CreatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture)</td><td>@if(e.Description.StartsWith("เครดิตทดลองอัตโนมัติ ",StringComparison.Ordinal)){<span>เติมเครดิตเข้ากระเป๋า</span><br/><small>เครดิตทดลอง · ไม่มีการเรียกเก็บเงินจริง</small>}else{@e.Description}</td><td>@(e.AmountSatang>0?"+":"−")฿@CourtTime.Money(Math.Abs(e.AmountSatang))</td></tr>}
@if(Model.Entries.Count==0){<tr><td colspan="3">ยังไม่มีรายการ</td></tr>}
</tbody></table></div></section>
