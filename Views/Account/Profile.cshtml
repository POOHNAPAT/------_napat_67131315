@model SiteUser
@{ViewData["Title"]="บัญชีของฉัน";}
<section class="form-panel"><p class="eyebrow">MY ACCOUNT</p><h1>บัญชีของฉัน</h1><dl class="details"><dt>ชื่อ</dt><dd>@Model.Name</dd><dt>อีเมล</dt><dd>@Model.Email</dd><dt>บทบาท</dt><dd>@(Model.Role=="Admin"?"ผู้ดูแลระบบ":"สมาชิก")</dd></dl><a class="button" asp-controller="@(Model.Role=="Admin"?"Admin":"Bookings")" asp-action="@(Model.Role=="Admin"?"Customers":"History")">@(Model.Role=="Admin"?"บัญชีลูกค้า":"ประวัติการจอง")</a>@if(Model.Role=="Member"){<a class="button secondary" asp-controller="Wallet" asp-action="Index">กระเป๋าเงินและแพ็กสมาชิก</a>}</section>
