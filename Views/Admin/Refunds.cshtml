@model RefundPage
@{ViewData["Title"]="คำขอคืนเงิน";}
<div class="accounting-page">
<div class="page-heading"><p class="eyebrow">REFUND REVIEW</p><h1>คำขอคืนเงินค่าจอง</h1><p>อนุมัติแล้วจะคืนเต็มยอดเข้ากระเป๋า COURTBOOK พร้อมยกเลิกการจองและคืนช่วงเวลาให้ว่าง</p><a asp-action="Accounting">กลับสรุปบัญชี ↗</a></div>
<form method="get" class="filter-panel"><div><label for="status">สถานะ</label><select name="status" id="status"><option value="">ทั้งหมด</option><option value="Pending" selected="@(Model.Status=="Pending")">รอตรวจสอบ</option><option value="Approved" selected="@(Model.Status=="Approved")">คืนเงินแล้ว</option><option value="Rejected" selected="@(Model.Status=="Rejected")">ไม่อนุมัติ</option></select></div><button class="button">กรองรายการ</button></form>
@if(Model.Refunds.Count==0){<p class="empty">ไม่มีคำขอ</p>}else{@foreach(var r in Model.Refunds){<section class="panel"><p class="eyebrow">@r.Reference · @r.StatusLabel</p><h2>@r.CourtName · ฿@CourtTime.Money(r.AmountSatang)</h2><p>@r.MemberName · @r.MemberEmail</p><p>ส่งคำขอ @DateTimeOffset.Parse(r.RequestedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</p><p class="accounting-reason">เหตุผล: @r.Reason</p><a asp-action="Booking" asp-route-id="@r.BookingId">ตรวจการจอง CB@(r.BookingId.ToString("000000")) ↗</a>
@if(r.Status=="Pending"){<form asp-action="ReviewRefund" asp-route-id="@r.Id" method="post" class="accounting-form"><div><label for="note-@r.Id">หมายเหตุผู้ดูแล (จำเป็นเมื่อไม่อนุมัติ)</label><textarea id="note-@r.Id" name="note" maxlength="1000" rows="2"></textarea></div><div class="accounting-actions"><button class="button" name="approve" value="true" type="submit">อนุมัติคืนเข้ากระเป๋า</button><button class="button secondary" name="approve" value="false" type="submit">ไม่อนุมัติ</button></div></form>}else{<p>ผู้ตรวจสอบ: @r.DecidedBy · @DateTimeOffset.Parse(r.DecidedAt!).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")<br/>@r.AdminNote</p>}</section>}}

</div>
