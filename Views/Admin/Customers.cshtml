@model IReadOnlyList<CustomerAccount>
@{ViewData["Title"]="บัญชีลูกค้า";}
<div class="page-heading"><p class="eyebrow">CUSTOMERS</p><h1>บัญชีลูกค้า</h1><p>รายชื่อสมาชิกและประวัติการจอง</p></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>ชื่อ</th><th>อีเมล</th><th>จำนวนการจอง</th><th></th></tr></thead><tbody>
@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Email</td><td>@c.Bookings</td><td><a asp-action="Customer" asp-route-id="@c.Id">ดูบัญชีและประวัติ →</a></td></tr>}
@if(Model.Count==0){<tr><td colspan="4" class="empty">ยังไม่มีบัญชีลูกค้า</td></tr>}
</tbody></table></div></section>
