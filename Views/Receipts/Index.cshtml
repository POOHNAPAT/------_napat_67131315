@model IReadOnlyList<PaymentReceipt>
@{ViewData["Title"]="ใบเสร็จของฉัน";}
<div class="page-heading"><p class="eyebrow">หลักฐานการชำระเงิน</p><h1>ใบเสร็จของฉัน</h1><p>ใบเสร็จค่าจองสนามและแพ็กสมาชิกที่ชำระสำเร็จแล้ว เปิดดู พิมพ์ หรือบันทึกเป็น PDF ได้</p></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>เลขที่ใบเสร็จ</th><th>รายการ</th><th>วันที่ชำระ</th><th>ยอดชำระ</th><th></th></tr></thead><tbody>@foreach(var receipt in Model){<tr><td class="reference">@receipt.Id</td><td>@receipt.Title<br/><small>@receipt.Data.SourceReference</small></td><td>@DateTimeOffset.Parse(receipt.Data.PaidAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture)</td><td>฿@CourtTime.Money(receipt.Data.NetSatang)</td><td><a class="button secondary small" asp-action="Details" asp-route-id="@receipt.Id">เปิดใบเสร็จ</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">ยังไม่มีรายการที่ยืนยันชำระสำเร็จ</td></tr>}</tbody></table></div></section>
