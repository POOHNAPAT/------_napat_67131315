@model Court
@if(Model.ImageUrl is not null){
<img class="court-photo" src="@Model.ImageUrl" alt="@Model.Name · @Model.SportTypeName" loading="lazy" decoding="async"/>
} else if(SportsAssets.Key(Model.SportTypeName)!="other") {
<img class="court-photo" src="@Model.SportImage" alt="ภาพประกอบกีฬา @Model.SportTypeName" loading="lazy" decoding="async"/>
<span class="illustration-label">ภาพประกอบประเภทกีฬา</span>
}
else {
<div class="court-photo-placeholder" role="img" aria-label="ยังไม่มีรูปภาพ @Model.Name"><span class="photo-court-lines" aria-hidden="true"></span><span class="photo-placeholder-caption">@Model.SportTypeName</span></div>
}
