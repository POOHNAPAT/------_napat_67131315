@model BookingPage
@{ViewData["Title"]="จองสนาม";}
<div class="page-heading"><p class="eyebrow">LET’S BOOK YOUR COURT</p><h1>จองสนาม</h1><p>เลือกชั่วโมงต่อเนื่องในสนามเดียวกัน และดูยอดก่อนยืนยัน</p><p class="help">ไม่รับจองวันย้อนหลังหรือช่วงเวลาที่เริ่มไปแล้ว ระบบตรวจเวลาในประเทศไทยอีกครั้งตอนยืนยันการจอง</p></div>
<ol class="booking-steps" aria-label="ขั้นตอนการจอง"><li><span>1</span>เลือกสนามและวันที่</li><li><span>2</span>เลือกเวลาและอุปกรณ์</li><li><span>3</span>ตรวจยอดและส่งคำขอ</li></ol>
<div asp-validation-summary="All" class="validation alert" role="alert"></div>
<form method="get" asp-action="Create" class="filter-panel"><div><label for="chooseCourt">สนาม</label><select id="chooseCourt" name="courtId">@foreach(var c in Model.Courts){<option value="@c.Id" selected="@(Model.Form.CourtId==c.Id)">@c.Name · ฿@CourtTime.Money(c.PriceSatang)/ชม.</option>}</select></div><div><label for="chooseDate">วันที่เล่น</label><input id="chooseDate" type="date" name="date" value="@CourtTime.Iso(Model.Form.Date)" min="@CourtTime.Iso(CourtTime.Today)" required/></div><button type="submit" class="button secondary">ดูช่วงเวลา</button></form>
<form method="post" asp-action="Create" id="booking-form" class="booking-grid" data-server-now="@DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()"><input type="hidden" name="ExpectedIncludedHours" value=""/>
<input type="hidden" name="CourtId" value="@Model.Form.CourtId"/><input type="hidden" name="Date" value="@CourtTime.Iso(Model.Form.Date)"/>
<section class="panel"><p class="eyebrow">01 / SELECT YOUR TIME</p><h2>เลือกช่วงเวลาว่าง</h2><div class="time-range-picker"><div><label for="start-hour">เวลาเริ่มต้น</label><select id="start-hour"><option value="">เลือกเวลา</option>@foreach(var h in CourtTime.Hours){<option value="@h">@CourtTime.Hour(h)</option>}</select></div><div><label for="end-hour">เวลาสิ้นสุด</label><select id="end-hour"><option value="">เลือกเวลา</option>@foreach(var h in Enumerable.Range(9,14)){<option value="@h">@CourtTime.Hour(h)</option>}</select></div><button id="apply-time-range" class="button secondary" type="button">เลือกช่วงนี้</button></div><p id="time-range-message" class="help" role="status"></p><p class="muted">เลือกได้หลายชั่วโมงที่ต่อเนื่องกัน เวลาในประเทศไทย</p><div class="slots booking-slots">@foreach(var slot in Model.Slots){<label class="slot-choice @(slot.Status=="Available"?"":"disabled")"><input type="checkbox" name="Hours" data-slot-start="@(CourtTime.Iso(Model.Form.Date)+"T"+CourtTime.Hour(slot.Hour)+":00+07:00")" value="@slot.Hour" checked="@(Model.Form.Hours.Contains(slot.Hour)&&slot.Status=="Available")" disabled="@(slot.Status!="Available")"/><span><strong>@slot.Label</strong><small>@slot.StatusLabel</small></span></label>}</div>@if(Model.Slots.Count==0){<p class="empty">ไม่มีสนามให้เลือกในขณะนี้</p>}
<fieldset class="equipment-rentals"><legend>เช่าอุปกรณ์เสริม (ไม่บังคับ)</legend>
@if(Model.Equipment.Count == 0){<p class="help">ยังไม่มีอุปกรณ์เสริมเปิดให้เช่าสำหรับกีฬานี้ สามารถจองสนามได้ตามปกติ</p>}<p class="help" id="equipment-help">ใช้ในวันและเวลาเดียวกับการจอง คิดค่าเช่าต่อครั้ง ไม่รวมส่วนลดสนาม เลือก 0 หากไม่ต้องการเช่า</p>
@foreach(var item in Model.Equipment){
<div class="equipment-row"><img class="equipment-image" src="@(string.IsNullOrEmpty(item.ImageUrl)?SportsAssets.Equipment(item.Name,item.SportTypeName):item.ImageUrl)" alt="@item.Name" loading="lazy"/><div><label for="equipment-@item.Id">@item.Name</label><span class="help">฿@CourtTime.Money(item.PriceSatang) / @item.Unit / ครั้ง</span></div><div><label for="equipment-@item.Id" class="help">จำนวน (@item.Unit)</label><input id="equipment-@item.Id" type="number" name="Equipment[@item.Id]" value="@Model.Form.Equipment.GetValueOrDefault(item.Id)" min="0" max="10" step="1" required aria-describedby="equipment-help"/></div></div>
}
</fieldset></section>
<aside class="panel booking-summary">@if(Model.Courts.SingleOrDefault(c=>c.Id==Model.Form.CourtId) is Court selectedCourt){<div class="booking-court-photo"><partial name="_CourtPhoto" model="selectedCourt"/></div>}<p class="eyebrow">02 / YOUR BOOKING</p><h2>สรุปค่าจอง</h2><p class="pill">@(Model.Courts.SingleOrDefault(c=>c.Id==Model.Form.CourtId)?.SportTypeName)</p><p>@(Model.Courts.SingleOrDefault(c=>c.Id==Model.Form.CourtId)?.Name??"ไม่พบสนาม") · @CourtTime.Display(Model.Form.Date)</p><label for="Players">จำนวนผู้เล่น</label><input type="number" id="Players" name="Players" min="1" max="100" value="@Model.Form.Players" required/><label for="PromotionId">โปรโมชั่น</label><select name="PromotionId" id="PromotionId"><option value="">ไม่ใช้โปรโมชั่น</option>@foreach(var p in Model.Promotions){<option value="@p.Id" selected="@(Model.Form.PromotionId==p.Id)">@p.Name · @p.DiscountLabel</option>}</select><p class="help">เลือกได้ไม่เกิน 1 โปรโมชั่น หากมีแพ็กสมาชิก ระบบจะเลือกสิทธิ์แพ็กหรือโปรโมชั่นที่คุ้มกว่าโดยไม่รวมซ้อนกัน</p><dl class="totals"><dt>ค่าจองสนาม</dt><dd id="court-total">—</dd><dt>ค่าเช่าอุปกรณ์</dt><dd id="equipment-total">—</dd><dt>ยอดรวมก่อนส่วนลด</dt><dd id="gross">—</dd><dt>ส่วนลด</dt><dd id="discount">—</dd><dt class="net">ยอดสุทธิ</dt><dd class="net" id="net">—</dd></dl><p id="selected-time" class="help" role="status"></p><p id="quote-message" class="help" role="status">เลือกช่วงเวลาเพื่อดูยอด</p><div class="payment-method"><strong>ใช้โควตาแพ็ก / QR / กระเป๋าเงิน</strong><span>หักโควตาตามรอบวันที่เล่นเมื่อส่งคำขอ ยอดส่วนเกินและอุปกรณ์ชำระในหน้ารายละเอียด</span></div><button class="button full" type="submit" id="confirm-booking">ส่งคำขอจอง</button><p class="help">ช่วงเวลาจะถูกกันไว้ระหว่างรอผู้ดูแลยืนยัน หากโควตาครอบคลุมเต็มยอดจะออกหลักฐานใช้สิทธิ์ให้ทันที</p></aside></form>
@section Scripts {<script src="~/js/availability.js" asp-append-version="true"></script><script src="~/js/booking.js" asp-append-version="true"></script>}
