@model IReadOnlyList<Court>
@{ViewData["Title"]="จัดการสนามและราคา";}
<div class="section-heading page-heading"><div><p class="eyebrow">YOUR COURTS</p><h1>จัดการสนามและราคา</h1><p>อัปเดตรูป บรรยากาศ และข้อมูลสนามให้พร้อมรับเกมถัดไป</p></div><a class="button" asp-action="Court" asp-route-id="0">+ เพิ่มสนาม</a></div>
<div class="admin-court-grid">@foreach(var c in Model){<article class="court-card photo-card"><a class="court-visual" asp-action="Court" asp-route-id="@c.Id"><partial name="_CourtPhoto" model="c"/><span class="photo-sport">@c.SportTypeName</span><span class="photo-card-arrow" aria-hidden="true">↗</span></a><div class="court-info"><div><h2>@c.Name</h2><span class="pill @(c.IsActive?"":"neutral")">@(c.IsActive?"เปิดให้จอง":"ปิดให้จอง")</span></div><div class="price">฿@CourtTime.Money(c.PriceSatang)<small>/ ชั่วโมง</small></div></div><p class="admin-court-description">@c.Description</p><div class="card-link"><a asp-action="Court" asp-route-id="@c.Id">แก้ไขข้อมูลและรูป ↗</a><a asp-action="Schedule" asp-route-courtId="@c.Id">จัดการเวลาว่าง →</a></div><form asp-action="DeleteCourt" asp-route-id="@c.Id" method="post" class="card-link" onsubmit="return confirm('ยืนยันลบสนามนี้หรือไม่? สนามจะไม่แสดงและจองใหม่ไม่ได้ ประวัติและรายการจองเดิมยังคงอยู่');"><button class="button small secondary" type="submit" aria-label="ลบสนาม @c.Name">ลบสนาม</button></form></article>}</div>
@if(Model.Count==0){<div class="empty">ยังไม่มีสนาม เริ่มเพิ่มสนามแรกของคุณได้เลย</div>}
