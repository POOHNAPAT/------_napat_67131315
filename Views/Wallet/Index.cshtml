@model WalletPage
@{ViewData["Title"]="กระเป๋าเงิน";}
<div class="page-heading"><p class="eyebrow">WALLET & MEMBERSHIP</p><h1>กระเป๋าเงิน</h1><p>เติมเงินและจัดการยอดสำหรับชำระค่าจอง</p></div>
<p class="action-group"><a class="button secondary" asp-controller="Accounting" asp-action="Index">บัญชีและการชำระเงิน</a><a class="button secondary" asp-controller="Receipts" asp-action="Index">ใบเสร็จของฉัน</a></p>
<div asp-validation-summary="All" class="validation alert" role="alert"></div>
<section class="panel"><p class="eyebrow">YOUR BALANCE</p><h2>ยอดคงเหลือ ฿@CourtTime.Money(Model.BalanceSatang)</h2><p>ใช้ชำระค่าจองในหน้ารายละเอียดการจองได้ โดยเลือกจ่ายจากกระเป๋าเงิน</p>
<div class="action-row"><a class="button" href="#topup">เติมเงินเข้ากระเป๋า</a></div>

</section>
@if(ViewData["DemoTopUpsEnabled"] is true){
<section class="panel" id="topup" aria-labelledby="automatic-topup-heading">
<p class="eyebrow">เครดิตทดลอง</p><h2 id="automatic-topup-heading">เติมเครดิตอัตโนมัติแบบทดลอง</h2>
<p class="alert">เครดิตทดลองใช้จองสนามและซื้อแพ็กในระบบได้ โดยรวมอยู่ในยอดกระเป๋า ไม่มีการเรียกเก็บเงินจริง</p>
<ol><li>ระบุยอดเครดิตที่ต้องการเติม</li><li>กด “ไปหน้าชำระเงินทดลอง”</li><li>กด “ชำระสำเร็จ” เพื่อเพิ่มเครดิตทดลองเข้ากระเป๋าทันที ไม่ต้องแนบสลิปหรือรอผู้ดูแล</li></ol>
<form asp-action="StartDemoPayment" method="post">
<label for="demo-amount">ยอดเครดิตทดลอง (บาท)</label><input id="demo-amount" name="Amount" type="number" min="1" max="100000" step="0.01" value="100" required aria-describedby="demo-amount-help"/>
<p class="help" id="demo-amount-help">ครั้งละ 1–100,000 บาท ทศนิยมไม่เกิน 2 ตำแหน่ง</p>
<button class="button" type="submit">ไปหน้าชำระเงินทดลอง</button></form>
<p><a href="#transfer-topup">เติมเงินผ่านธนาคารและแนบสลิป</a></p>
</section>
}
<section class="panel" id="@(ViewData["DemoTopUpsEnabled"] is true ? "transfer-topup" : "topup")" aria-labelledby="topup-heading"><p class="eyebrow">TOP UP</p><h2 id="topup-heading">เติมเงินด้วยการโอนและแนบสลิป</h2>
<h3>วิธีเติมเงินผ่านแอปธนาคาร</h3>
<ol>
<li><strong>สแกน QR ด้านล่าง</strong> หรือกดบันทึก QR แล้วเลือกรูปจากอัลบั้มในแอปธนาคาร</li>
<li><strong>กรอกยอดที่ต้องการเติม 1–100,000 บาท</strong> ตรวจสอบชื่อผู้รับและยอดเงินในแอปธนาคารก่อนยืนยันโอน QR นี้ไม่ได้กำหนดยอดเงินไว้</li>
<li><strong>บันทึกสลิปหลังโอนสำเร็จ</strong> แล้วกรอกยอดที่โอนและแนบรูปสลิปในแบบฟอร์มด้านล่าง</li>
<li><strong>กด “แจ้งเติมเงิน”</strong> ผู้ดูแลจะตรวจรายการรับเงินจริงก่อนอนุมัติ เมื่ออนุมัติแล้วดูยอดได้ในประวัติกระเป๋าเงิน</li>
</ol>
<p class="alert">การส่งสลิปยังไม่เพิ่มยอดเงิน ยอดจะเข้ากระเป๋าเมื่อสถานะเป็น “เติมเงินสำเร็จ” ไม่ต้องโอนซ้ำระหว่างรอตรวจสอบ</p>
<div class="qr-payment-grid"><div class="qr-code-card"><img src="~/images/payment-qr.jpg" asp-append-version="true" alt="QR สำหรับโอนเงินเติมกระเป๋า"/><a class="button secondary small" href="~/images/payment-qr.jpg" download="courtbook-topup-qr.jpg">บันทึก QR สำหรับเติมเงิน</a></div>
<form asp-action="TopUp" method="post" enctype="multipart/form-data"><label for="topup-amount">ยอดที่โอน (บาท)</label><input id="topup-amount" name="Amount" type="number" min="1" max="100000" step="0.01" required/>
<label for="topup-slip">สลิปโอนเงิน</label><input id="topup-slip" name="Slip" type="file" accept="image/jpeg,image/png,image/webp" required/>
<p class="help">JPG, PNG หรือ WebP ไม่เกิน 5 MB · ใช้สลิปใหม่สำหรับเติมเงินเท่านั้น ห้ามใช้สลิปที่ชำระค่าจองแล้ว</p>
<button class="button" type="submit">แจ้งเติมเงิน</button></form></div></section>
<section class="panel"><h2>ประวัติกระเป๋าเงิน</h2><div class="table-wrap"><table><thead><tr><th>เวลา</th><th>รายการ</th><th>ยอดเงินเข้า / ออก</th></tr></thead><tbody>
@foreach(var e in Model.Entries){<tr><td>@DateTimeOffset.Parse(e.CreatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture)</td><td>@e.Description</td><td>@(e.AmountSatang>0?"+":"−")฿@CourtTime.Money(Math.Abs(e.AmountSatang))</td></tr>}
@if(Model.Entries.Count==0){<tr><td colspan="3">ยังไม่มีรายการ</td></tr>}
</tbody></table></div></section>
