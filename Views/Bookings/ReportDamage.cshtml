@model DamageReportPage
@{ViewData["Title"]="แจ้งปัญหาให้ผู้ดูแล";var booking=Model.Booking;}
<div class="page-heading"><p class="eyebrow">ติดต่อผู้ดูแล</p><h1>แจ้งปัญหาการใช้งาน</h1>@if(booking is not null){<p>@booking.Reference · @booking.CourtName · @CourtTime.Display(booking.Date) · @booking.TimeLabel</p>}else{<p>พิมพ์ปัญหาทั่วไป หรือแจ้งสนามและอุปกรณ์ชำรุดได้โดยไม่ต้องมีรายการจอง</p>}</div>
<div class="damage-report-grid"><section class="panel"><h2>ส่งข้อความถึงผู้ดูแล</h2>
@if(booking is null){<partial name="_GeneralReportForm" model="Model.Form"/>}else if(booking.ApprovalStatus=="Cancelled"){
<p class="alert">รายการจองนี้ยกเลิกแล้ว คุณสามารถแจ้งปัญหาโดยไม่ผูกการจองได้</p><a class="button" asp-action="ReportDamage" asp-route-id="">แจ้งปัญหาทั่วไป</a>
}else{
<form method="post" asp-action="ReportDamage" asp-route-id="@booking.Id" id="damage-report-form"><div asp-validation-summary="All" class="validation alert" role="alert"></div>
<label for="damage-category">ประเภทปัญหา</label><select name="Category" id="damage-category"><option value="Court" selected="@(Model.Form.Category=="Court")">สนามหรือสิ่งอำนวยความสะดวกในสนาม</option><option value="Equipment" selected="@(Model.Form.Category=="Equipment")" disabled="@(booking.Equipment.Count==0)">อุปกรณ์ที่เช่าในรายการนี้</option><option value="Other" selected="@(Model.Form.Category=="Other")">ปัญหาทั่วไป</option></select>
<div id="damage-equipment-field"><label for="damage-equipment">อุปกรณ์ที่ชำรุด</label><select name="EquipmentId" id="damage-equipment"><option value="">เลือกอุปกรณ์</option>@foreach(var item in booking.Equipment){<option value="@item.Id" selected="@(Model.Form.EquipmentId==item.Id)">@item.Name · เช่า @item.Quantity @item.Unit</option>}</select></div>
<label for="damage-description">รายละเอียดปัญหา</label><textarea name="Description" id="damage-description" rows="6" minlength="5" maxlength="2000" required aria-describedby="damage-description-help" placeholder="พิมพ์ปัญหาที่ต้องการแจ้งให้ผู้ดูแลทราบ">@Model.Form.Description</textarea><p class="help" id="damage-description-help">5–2,000 ตัวอักษร</p><button class="button full" type="submit">ส่งให้ผู้ดูแล</button></form>
<p class="help"><a asp-action="ReportDamage" asp-route-id="">แจ้งสนาม อุปกรณ์ หรือปัญหาอื่นโดยไม่ผูกกับการจอง</a></p>
}
<p><a class="inline-link" asp-action="@(booking is null?"History":"Result")" asp-route-id="@booking?.Id">@(booking is null?"การจองของฉัน":"กลับรายละเอียดการจอง")</a></p></section>
<section class="panel"><h2>ข้อความและรายงานของคุณ</h2><p class="help">ติดตามสถานะและคำตอบจากผู้ดูแลได้ที่นี่</p>@foreach(var report in Model.Reports){<partial name="_DamageReport" model="report"/>}@if(Model.Reports.Count==0){<p class="empty">ยังไม่มีข้อความที่ส่ง</p>}</section></div>
@section Scripts {<script src="~/js/damage-report.js" asp-append-version="true"></script>}
