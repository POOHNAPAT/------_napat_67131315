@model DamageReport
<article class="damage-report-record" id="report-@Model.Id"><div class="section-heading"><strong>@Model.Reference</strong><span class="pill damage-status-@Model.DisplayStatus">@DamageClaim.Label(Model.DisplayStatus)</span></div><h3>@Model.TargetLabel</h3><p class="damage-report-text">@Model.Description</p><small>แจ้งเมื่อ @DateTimeOffset.Parse(Model.CreatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture) น.</small>
@if(Model.UpdatedAt is not null&&Model.Claim is null){<div class="damage-admin-reply"><strong>คำตอบจากผู้ดูแล</strong><p class="damage-report-text">@(string.IsNullOrWhiteSpace(Model.AdminNote)?"ผู้ดูแลอัปเดตสถานะเป็น “"+DamageReport.Label(Model.Status)+"”":Model.AdminNote)</p><small>@Model.UpdatedByName · @DateTimeOffset.Parse(Model.UpdatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture) น.</small></div>}
<partial name="_DamageClaim" model="Model"/></article>
