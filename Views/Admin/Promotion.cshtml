@model PromotionForm
@{ViewData["Title"]=Model.Id==0?"เพิ่มโปรโมชั่น":"แก้ไขโปรโมชั่น";}
<section class="form-panel wide-form"><p class="eyebrow">PROMOTION SETTINGS</p><h1>@ViewData["Title"]</h1><form method="post" asp-action="Promotion" asp-route-id="@Model.Id"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">ชื่อโปรโมชั่น</label><input asp-for="Name" maxlength="100" required/><label asp-for="Rule">เงื่อนไขการใช้สิทธิ์</label><select asp-for="Rule"><option value="NewMember">สมาชิกใหม่: การจองครั้งแรก</option><option value="Consecutive">จองต่อเนื่อง: จำนวนชั่วโมงขั้นต่ำ</option><option value="WeekdayMorning">เช้าวันธรรมดา: จันทร์–ศุกร์ ทุกชั่วโมงอยู่ใน 08:00–12:00</option><option value="Advance">จองล่วงหน้า: จำนวนวันตามปฏิทิน</option><option value="Threshold">ยอดจองครบ: ยอดก่อนส่วนลดขั้นต่ำ</option></select>
<div class="form-grid"><div><label asp-for="Kind">ประเภทส่วนลด</label><select asp-for="Kind"><option value="Fixed">จำนวนเงิน (บาท)</option><option value="Percent">เปอร์เซ็นต์ (%)</option></select></div><div><label asp-for="Value">จำนวนส่วนลด</label><input asp-for="Value" type="number" min="0.01" max="100000" step="0.01" required/></div></div><p class="help">ส่วนลดเปอร์เซ็นต์ต้องไม่เกิน 100% ส่วนลดจริงไม่เกินยอดค่าจอง</p>
<div class="form-grid"><div><label asp-for="MinHours">ชั่วโมงขั้นต่ำ (จองต่อเนื่อง)</label><input asp-for="MinHours" type="number" min="1" max="14" required/></div><div><label asp-for="MinDays">วันล่วงหน้าขั้นต่ำ (จองล่วงหน้า)</label><input asp-for="MinDays" type="number" min="1" max="3650" required/></div></div><label asp-for="MinSpend">ยอดก่อนส่วนลดขั้นต่ำ (ยอดจองครบ / บาท)</label><input asp-for="MinSpend" type="number" min="1" max="1000000" step="0.01" required/><p class="help">ใช้เฉพาะค่าของเงื่อนไขที่เลือก เงื่อนไขอื่นไม่ถูกนำมารวม</p>
<div class="form-grid"><div><label asp-for="Starts">วันเริ่มต้น</label><input asp-for="Starts" type="date" asp-format="{0:yyyy-MM-dd}" required/></div><div><label asp-for="Ends">วันสิ้นสุด</label><input asp-for="Ends" type="date" asp-format="{0:yyyy-MM-dd}" required/></div></div><label class="checkbox"><input asp-for="IsActive"/> เปิดใช้งาน</label><button class="button full" type="submit">บันทึกโปรโมชั่น</button></form><p class="form-bottom"><a asp-action="Promotions">ยกเลิกและกลับรายการ</a></p></section>
