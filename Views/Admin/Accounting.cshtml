@model AccountingPage
@{ViewData["Title"]="บัญชีรายรับ–รายจ่าย";}
<div class="accounting-page">
<div class="page-heading"><p class="eyebrow">FINANCE OVERVIEW</p><h1>บัญชีรายรับ–รายจ่าย</h1><p>สรุปตามวันที่รับชำระ อนุมัติเติมเงิน คืนเงิน และวันที่จ่าย ตามเวลาไทย</p></div>
<form method="get" class="filter-panel"><div><label for="from">ตั้งแต่วันที่</label><input type="date" id="from" name="from" value="@CourtTime.Iso(Model.From)" required/></div><div><label for="to">ถึงวันที่</label><input type="date" id="to" name="to" value="@CourtTime.Iso(Model.To)" required/></div><button class="button">ดูรายงาน</button><a class="button secondary" asp-action="AccountingExport" asp-route-from="@CourtTime.Iso(Model.From)" asp-route-to="@CourtTime.Iso(Model.To)">ส่งออก CSV</a></form>
<div class="stat-grid"><section class="stat-card"><span>ชำระค่าจองสนาม</span><strong>฿@CourtTime.Money(Model.BookingSatang)</strong></section><section class="stat-card"><span>ซื้อแพ็กสมาชิก</span><strong>฿@CourtTime.Money(Model.MembershipSatang)</strong></section><section class="stat-card"><span>ชำระค่าซ่อม / ค่าเสียหาย</span><strong>฿@CourtTime.Money(Model.DamageSatang)</strong></section><section class="stat-card"><span>คืนค่าจองเข้ากระเป๋า</span><strong>฿@CourtTime.Money(Model.RefundSatang)</strong><a asp-action="Refunds">ตรวจคำขอ ↗</a></section><section class="stat-card"><span>รายรับรวมหลังหักคืนเงิน</span><strong>฿@CourtTime.Money(Model.NetSalesSatang)</strong></section></div>
<section class="panel"><h2>การเคลื่อนไหวของเงิน</h2><dl class="totals"><dt>รับเงินจริงจากภายนอก</dt><dd>฿@CourtTime.Money(Model.ExternalInSatang)</dd><dt>รายจ่ายที่บันทึกและไม่ยกเลิก</dt><dd>฿@CourtTime.Money(Model.ExpenseSatang)</dd><dt class="net">ผลต่างเงินรับและรายจ่าย</dt><dd class="net">฿@CourtTime.Money(Model.CashDifferenceSatang)</dd></dl><p class="help">เงินรับภายนอกรวมยอดเติมเงินธนาคารและค่าจองที่รับชำระโดยตรง การจ่ายผ่านกระเป๋าและซื้อแพ็กไม่ถูกนับซ้ำ ผลต่างนี้เป็นสรุปเงินเคลื่อนไหวตามรายการที่บันทึก</p><p>ยอดกระเป๋าลูกค้าคงเหลือปัจจุบัน ฿@CourtTime.Money(Model.WalletBalanceSatang) · เครดิตทดลองที่เพิ่มในช่วงนี้ ฿@CourtTime.Money(Model.DemoSatang) (แยกจากเงินรับจริง)</p><a class="button" asp-action="Expenses">บันทึกและตรวจรายจ่าย</a></section>
<section class="panel"><h2>รายละเอียดรายการ</h2><p class="help">รายการยกเลิกรายจ่ายคงอยู่เพื่อการตรวจสอบและไม่นำไปรวมยอด</p><partial name="_AccountingEntries" model="Model.Entries"/></section>

</div>
