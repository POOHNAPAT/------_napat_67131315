@model ResetPasswordForm
@{ViewData["Title"]="ตั้งรหัสผ่านใหม่";}
<section class="form-panel"><h1>ตั้งรหัสผ่านใหม่</h1><div asp-validation-summary="All" class="validation alert" role="alert"></div>
@if(ViewBag.ValidToken is true){<form method="post"><input asp-for="Token" type="hidden"/><label asp-for="Password">รหัสผ่านใหม่ (8–128 ตัวอักษร)</label><input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password"/><label asp-for="ConfirmPassword">ยืนยันรหัสผ่านใหม่</label><input asp-for="ConfirmPassword" type="password" required autocomplete="new-password"/><button class="button full" type="submit">เปลี่ยนรหัสผ่าน</button></form>}else{<p class="alert">ลิงก์ไม่ถูกต้อง หมดอายุ หรือถูกใช้งานแล้ว</p><a class="button" asp-action="ForgotPassword">ขอลิงก์ใหม่</a>}</section>
