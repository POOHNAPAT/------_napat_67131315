@model IReadOnlyList<MembershipPlan>
@{var allowPurchase=ViewData["AllowPlanPurchase"] is true;var wallet=ViewBag.MembershipWallet as WalletPage;}
<div class="membership-grid">@foreach(var plan in Model.Where(p=>p.Id is "monthly" or "yearly")){
<article class="panel membership-card @(plan.Id=="yearly"?"featured-plan":"")"><p class="eyebrow">@(plan.Id=="monthly"?"เล่นคล่องตัวทุกเดือน":"เล่นต่อเนื่องตลอดปี")</p><h3>@plan.Name</h3><p>ระยะเวลา @plan.Months เดือน</p>
@if(plan.IsActive&&plan.PriceSatang>0&&plan.DiscountPercent>0){<p class="plan-price">฿@CourtTime.Money(plan.PriceSatang)</p>@if(plan.MonthlyHours>0){<p class="plan-quota"><strong>@plan.MonthlyHours ชั่วโมงสนาม / เดือน</strong><br/>สำหรับ @plan.QuotaSportName</p><p>ใช้เกินโควตา ลดค่าจอง @plan.DiscountPercent%</p>}else{<p>ส่วนลดค่าจองสนาม @plan.DiscountPercent%</p>}<ul><li>ใช้กับวันที่เล่นภายในอายุแพ็ก และต้องจองเวลาว่างก่อน</li>@if(plan.MonthlyHours>0){<li>โควตารอบเดือนเริ่มจากวันซื้อ ไม่ทบยอด</li><li>ไม่รวมค่าเช่าอุปกรณ์</li>}<li>ไม่ต่ออายุอัตโนมัติ</li></ul>@if(allowPurchase&&wallet is not null){
<form asp-controller="Wallet" asp-action="Buy" method="post" onsubmit="return confirm('ยืนยันซื้อแพ็กด้วยยอดเงินในกระเป๋า? แพ็กจะเริ่มใช้งานทันที');"><input type="hidden" name="planId" value="@plan.Id"/><input type="hidden" name="expectedMonthlyHours" value="@plan.MonthlyHours"/><input type="hidden" name="expectedQuotaSportTypeId" value="@plan.QuotaSportTypeId"/><input type="hidden" name="expectedMonths" value="@plan.Months"/><input type="hidden" name="expectedPriceSatang" value="@plan.PriceSatang"/><input type="hidden" name="expectedDiscountPercent" value="@plan.DiscountPercent"/><button class="button full" type="submit" disabled="@(wallet.Membership is not null||wallet.BalanceSatang<plan.PriceSatang)">ซื้อ@(plan.Name)</button></form>
@if(wallet.Membership is not null){<p class="help">ซื้อแพ็กใหม่ได้เมื่อแพ็กปัจจุบันหมดอายุ</p>}else if(wallet.BalanceSatang<plan.PriceSatang){<p class="help">กรุณาเติมเงินให้เพียงพอก่อนซื้อ</p>}
}else if(allowPurchase){<a class="button full" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Membership">เข้าสู่ระบบเพื่อสมัครแพ็ก</a>}else{<a class="button full" asp-controller="Home" asp-action="Membership">ดูรายละเอียดและสมัครแพ็ก</a>}
}else{<p class="plan-price">ยังไม่เปิดขาย</p><p class="help">ราคาและส่วนลดจะแสดงเมื่อผู้ดูแลตั้งค่าและเปิดขาย</p><a class="button secondary full" asp-controller="Account" asp-action="Register">สมัครบัญชีสมาชิก</a>}
</article>}</div><p class="help">โควตาและส่วนลดใช้กับค่าจองสนามตามเงื่อนไขแพ็ก ไม่รวมอุปกรณ์ และไม่รวมซ้อนกับโปรโมชั่น เลือกใช้ส่วนลดที่มากกว่า</p>
