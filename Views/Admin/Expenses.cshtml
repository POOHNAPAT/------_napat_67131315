@model ExpensePage
@{ViewData["Title"]="รายจ่าย";var f=Model.Form;}
<div class="accounting-page">
<div class="page-heading"><p class="eyebrow">EXPENSES</p><h1>บันทึกรายจ่าย</h1><p>เก็บผู้บันทึกและเหตุผลยกเลิกเพื่อให้ตรวจสอบย้อนหลังได้</p><a asp-action="Accounting">กลับสรุปบัญชี ↗</a></div>
<section class="panel"><h2>เพิ่มรายจ่ายที่จ่ายแล้ว</h2><form method="post" asp-action="Expenses" class="accounting-form"><div asp-validation-summary="All" class="validation"></div><div class="accounting-fields"><div><label for="date">วันที่จ่าย</label><input id="date" name="Date" type="date" value="@CourtTime.Iso(f.Date)" max="@CourtTime.Iso(CourtTime.Today)" required/></div><div><label for="category">หมวดรายจ่าย</label><select name="Category" id="category">@foreach(var category in ExpenseForm.Categories){<option value="@category" selected="@(f.Category==category)">@ExpenseForm.Label(category)</option>}</select></div><div><label for="amount">จำนวนเงิน (บาท)</label><input type="number" name="Amount" id="amount" min="0.01" max="1000000" step="0.01" value="@f.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" required/></div><div><label for="payee">ผู้รับเงิน</label><input name="Payee" id="payee" value="@f.Payee" required maxlength="150"/></div><div><label for="method">ช่องทางชำระ</label><select name="Method" id="method"><option value="Transfer" selected="@(f.Method=="Transfer")">โอนเงิน</option><option value="Cash" selected="@(f.Method=="Cash")">เงินสด</option></select></div><div><label for="reference">เลขที่เอกสาร / อ้างอิง</label><input name="Reference" id="reference" value="@f.Reference" required maxlength="200"/></div></div><div><label for="description">รายละเอียด</label><textarea name="Description" id="description" required minlength="5" maxlength="500" rows="3">@f.Description</textarea></div><button class="button" type="submit">บันทึกรายจ่าย</button></form></section>
<section class="panel"><h2>ประวัติรายจ่าย</h2><form method="get" class="filter-panel"><div><label for="from">ตั้งแต่วันที่</label><input type="date" id="from" name="from" value="@CourtTime.Iso(Model.From??new DateOnly(CourtTime.Today.Year,CourtTime.Today.Month,1))" required/></div><div><label for="to">ถึงวันที่</label><input type="date" id="to" name="to" value="@CourtTime.Iso(Model.To??CourtTime.Today)" required/></div><button class="button secondary">กรองรายจ่าย</button></form><p class="help">ส่งออก CSV ได้ที่หน้าสรุปบัญชี</p>@if(Model.Expenses.Count==0){<p class="empty">ไม่มีรายจ่ายในช่วงวันที่นี้</p>}else{<div class="table-wrap"><table><thead><tr><th>วันที่ / เอกสาร</th><th>รายละเอียด</th><th>จำนวนเงิน</th><th>ผู้บันทึก</th><th>สถานะ</th></tr></thead><tbody>@foreach(var e in Model.Expenses){<tr><td>@CourtTime.Display(e.Date)<br/>EX@(e.Id.ToString("000000"))<br/>@e.Reference</td><td>@ExpenseForm.Label(e.Category)<br/>@e.Description<br/>ผู้รับ: @e.Payee</td><td>฿@CourtTime.Money(e.AmountSatang)</td><td>@e.CreatedBy<br/><small>@DateTimeOffset.Parse(e.CreatedAt).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small></td><td>@if(e.Status=="Active"){<form asp-action="VoidExpense" asp-route-id="@e.Id" method="post"><label for="void-@e.Id">เหตุผลยกเลิก</label><input id="void-@e.Id" name="reason" required minlength="5" maxlength="500"/><button class="button small secondary" type="submit">ยกเลิกรายจ่าย</button></form>}else{<strong>ยกเลิกแล้ว</strong><p>@e.VoidReason<br/>โดย @e.VoidedBy<br/>@DateTimeOffset.Parse(e.VoidedAt!).ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</p>}</td></tr>}</tbody></table></div>}</section>

</div>
