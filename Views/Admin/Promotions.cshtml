@model IReadOnlyList<Promotion>
@{ViewData["Title"]="จัดการโปรโมชั่น";}
<div class="section-heading page-heading"><div><p class="eyebrow">PROMOTIONS</p><h1>จัดการโปรโมชั่น</h1></div><a class="button" asp-action="Promotion" asp-route-id="0">+ เพิ่มโปรโมชั่น</a></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>โปรโมชั่น</th><th>เงื่อนไข / ส่วนลด</th><th>ช่วงใช้งาน</th><th>สถานะ</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Name</strong></td><td>@p.Condition<br/><strong>@p.DiscountLabel</strong></td><td>@CourtTime.Display(p.Starts)<br/>– @CourtTime.Display(p.Ends)</td><td><span class="pill @(p.IsActive&&p.Starts<=CourtTime.Today&&p.Ends>=CourtTime.Today?"":"neutral")">@(p.IsActive?(p.Starts>CourtTime.Today?"ยังไม่เริ่ม":p.Ends<CourtTime.Today?"หมดอายุ":"เปิดใช้งาน"):"ปิดใช้งาน")</span></td><td><a asp-action="Promotion" asp-route-id="@p.Id">แก้ไข →</a></td></tr>}</tbody></table></div></section>
