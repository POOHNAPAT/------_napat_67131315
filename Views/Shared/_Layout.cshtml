@{
    var adminPortal = Context.Items["AdminPortal"] is true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool Current(string c, string a = "Index") => controller == c && action == a;
    bool AdminSection(string a) => action == a || (a == "Courts" && action == "Court")
        || (a == "Bookings" && action == "Booking") || (a == "CheckIn" && action is "CheckInLookup" or "ConfirmCheckIn") || (a == "Customers" && action == "Customer")
        || (a == "Promotions" && action == "Promotion") || (a == "Equipment" && action == "EquipmentItem") || (a == "Inventory" && action is "EquipmentStock" or "EquipmentHandover");
}
<!doctype html>
<html lang="th">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101310"/><meta name="color-scheme" content="dark"/>
<title>@ViewData["Title"] · COURTBOOK</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/green-club.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/courtbook-dark.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/damage-claims.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/checkin.css" asp-append-version="true"/></head>
<body class="@(adminPortal ? "admin-portal" : "customer-portal")">
<a class="skip-link" href="#main-content">ข้ามไปเนื้อหา</a>
<header class="site-header"><nav class="nav container" aria-label="เมนูหลัก">
<a class="brand" asp-controller="@(adminPortal ? "Admin" : "Home")" asp-action="Index"><span class="brand-icon" aria-hidden="true">C</span>COURT<span>BOOK</span></a>
@if(!adminPortal) {<div class="nav-main">
<a asp-controller="Home" asp-action="Index" aria-current="@(Current("Home") ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-6v-7H9v7H3Z"/></svg><span>หน้าแรก</span></a>
<a asp-controller="Courts" asp-action="Index" aria-current="@(controller is "Courts" or "Bookings" && action!="History" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16M3 12h18M7 4v16M17 4v16"/></svg><span>สนามกีฬา</span></a>
<a asp-controller="Wallet" asp-action="Index" aria-current="@(controller == "Wallet" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18m-6 4h6v4h-6z"/></svg><span>กระเป๋าเงิน</span></a>
<a asp-controller="Home" asp-action="Promotions" aria-current="@(Current("Home","Promotions") ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h9l9 9-9 9-9-9Z"/><circle cx="8" cy="8" r="1"/></svg><span>โปรโมชั่น</span></a>
<a asp-controller="Bookings" asp-action="History" aria-current="@(Current("Bookings","History") ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M4 11h16m-11 5 2 2 4-4"/></svg><span>การจองของฉัน</span></a>
</div>}
@if(!adminPortal){<div class="nav-discovery"><a asp-controller="Home" asp-action="Index" asp-fragment="how-to-book">วิธีจอง</a><a asp-controller="Home" asp-action="About">เกี่ยวกับเรา</a><a asp-controller="Bookings" asp-action="ReportDamage">แจ้งปัญหา</a></div>}
<div class="nav-account">
@if(User.Identity?.IsAuthenticated == true) {
@if(User.IsInRole("Admin")){<a class="button small secondary" asp-controller="Admin" asp-action="Index">หลังบ้าน</a>}
<a class="account-name" asp-controller="Account" asp-action="Profile">@User.Identity.Name</a>
<form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button" type="submit">ออกจากระบบ</button></form>
} else {<a asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>@if(!adminPortal){<a class="button small" asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>}}
</div></nav></header>
<main id="main-content" class="container main" tabindex="-1">
@if(TempData["Success"] is string success){<p class="alert success" role="status">@success</p>}
@if(TempData["Error"] is string error){<p class="alert error" role="alert">@error</p>}
@if(ViewContext.RouteData.Values["controller"]?.ToString()=="Admin") {
<div class="admin-head"><span class="eyebrow">COURTBOOK / ผู้ดูแลระบบ</span><a asp-controller="Account" asp-action="Profile">บัญชีผู้ดูแล ↗</a></div>
<div class="admin-shell"><nav class="admin-nav" aria-label="เมนูผู้ดูแล"><div class="admin-nav-brand"><span class="brand-icon" aria-hidden="true">C</span><div><strong>พื้นที่ผู้ดูแล</strong><small>COURTBOOK MANAGEMENT</small></div></div><span class="eyebrow">จัดการระบบ</span><a asp-action="Index" aria-current="@(AdminSection("Index") ? "page" : null)"><span aria-hidden="true">◫</span>ภาพรวม</a><a asp-action="Courts" aria-current="@(AdminSection("Courts") ? "page" : null)"><span aria-hidden="true">▦</span>จัดการสนาม</a><a asp-action="Schedule" aria-current="@(AdminSection("Schedule") ? "page" : null)"><span aria-hidden="true">◷</span>ตารางเวลา</a><a asp-action="CheckIn" aria-current="@(AdminSection("CheckIn") ? "page" : null)"><span aria-hidden="true">✓</span>เช็กอินเข้าสนาม</a><a asp-action="Bookings" aria-current="@(AdminSection("Bookings") ? "page" : null)"><span aria-hidden="true">☷</span>รายการจอง</a><a asp-action="Promotions" aria-current="@(AdminSection("Promotions") ? "page" : null)"><span aria-hidden="true">◇</span>โปรโมชั่น</a><a asp-action="Customers" aria-current="@(AdminSection("Customers") ? "page" : null)"><span aria-hidden="true">◎</span>บัญชีลูกค้า</a><a asp-action="SportTypes" aria-current="@(AdminSection("SportTypes") ? "page" : null)"><span aria-hidden="true">✳</span>ประเภทกีฬา</a><a asp-action="DamageReports" aria-current="@(AdminSection("DamageReports") ? "page" : null)"><span aria-hidden="true">⚑</span>ข้อความแจ้งปัญหา</a><a asp-action="Accounting" aria-current="@(AdminSection("Accounting") ? "page" : null)"><span aria-hidden="true">฿</span>บัญชีรายรับ–รายจ่าย</a><a asp-action="Expenses" aria-current="@(AdminSection("Expenses") ? "page" : null)"><span aria-hidden="true">↗</span>บันทึกรายจ่าย</a><a asp-action="Refunds" aria-current="@(AdminSection("Refunds") ? "page" : null)"><span aria-hidden="true">↶</span>คำขอคืนเงิน</a><a asp-action="Revenue" aria-current="@(AdminSection("Revenue") ? "page" : null)"><span aria-hidden="true">▥</span>รายได้และสถิติ</a><a asp-action="TopUps" aria-current="@(AdminSection("TopUps") ? "page" : null)"><span aria-hidden="true">฿</span>คำขอเติมเงิน</a><a asp-action="Inventory" aria-current="@(AdminSection("Inventory") ? "page" : null)"><span aria-hidden="true">▦</span>สต็อก / รับ–คืน</a><a asp-action="Equipment" aria-current="@(AdminSection("Equipment") ? "page" : null)"><span aria-hidden="true">♧</span>อุปกรณ์เสริม</a><a asp-action="Plans" aria-current="@(AdminSection("Plans") ? "page" : null)"><span aria-hidden="true">◇</span>แพ็กสมาชิก</a><p class="admin-nav-note">สนามพร้อม ทุกเกมก็พร้อม<br/>ดูแลประสบการณ์ที่ดีให้สมาชิก</p></nav><div class="admin-content">@RenderBody()</div></div>
}
else { @RenderBody() }
</main>
<footer class="footer"><div class="container footer-grid"><div><a class="brand" asp-controller="@(adminPortal ? "Admin" : "Home")" asp-action="Index">COURTBOOK<span class="dot">.</span></a><p>เลือกเวลา นัดเพื่อน แล้วมาเล่นกัน</p><small>เปิดให้จองทุกวัน 08:00–22:00 น. · เวลาในประเทศไทย</small></div>@if(!adminPortal){<div class="footer-links"><a asp-controller="Courts" asp-action="Index">สนามและเวลา</a><a asp-controller="Home" asp-action="Promotions">โปรโมชั่น</a><a asp-controller="Home" asp-action="About">เกี่ยวกับเรา</a><a asp-controller="Home" asp-action="Index" asp-fragment="how-to-book">วิธีจอง</a><a asp-controller="Bookings" asp-action="ReportDamage">แจ้งปัญหา</a><a asp-controller="Accounting" asp-action="Index">บัญชีและการชำระเงิน</a><a asp-controller="Home" asp-action="Contact">ติดต่อผู้ดูแลระบบ</a></div>}</div><div class="container credit">ณภัทร พิชัยรัตน์ · 67131315 <span>SPORT COURT BOOKING / CSI402</span></div></footer>
@await RenderSectionAsync("Scripts",required:false)
</body></html>
