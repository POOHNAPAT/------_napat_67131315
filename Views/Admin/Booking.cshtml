@model Booking
@{ViewData["Title"]="รายละเอียด "+Model.Reference;}
<section class="result-panel"><p class="eyebrow">BOOKING DETAILS</p><h1>รายละเอียด @Model.Reference</h1><div asp-validation-summary="All" class="validation" role="alert"></div><partial name="_BookingDetails" model="Model"/>
@if(Model.ApprovalStatus=="Pending"){
<form method="post" asp-action="ConfirmBooking" asp-route-id="@Model.Id"><button class="button" type="submit">ยืนยันการจอง</button></form>
}
@if(Model.ApprovalStatus=="Confirmed" && Model.PaidAt is null){
@if(Model.PaymentSubmittedAt is not null){<section class="submitted-payment"><h2>หลักฐานโอนจากลูกค้า</h2><p>เลขรายการโอน: <strong>@Model.TransferReference</strong></p><a asp-action="PaymentSlip" asp-route-id="@Model.Id" target="_blank" rel="noopener"><img class="payment-slip-image" src="@Url.Action("PaymentSlip", "Admin", new { id=Model.Id })" alt="สลิปโอนเงินของ @Model.Reference"/></a><p class="help">ตรวจสอบยอดและเลขรายการกับเงินที่ได้รับจริงก่อนยืนยันรับเงิน</p></section>}
<section class="panel"><h2>ยืนยันการชำระเงิน</h2><p>ตรวจสอบว่าได้รับเงินจริงครบ ฿@CourtTime.Money(Model.NetSatang) ก่อนยืนยัน</p><form method="post" asp-action="ConfirmPayment" asp-route-id="@Model.Id"><label for="payment-reference">เลขอ้างอิง / รายละเอียดรับเงิน</label><input id="payment-reference" name="Reference" value="@Model.TransferReference" maxlength="200" required placeholder="เช่น เลขรายการโอน หรือรับเงินสด ณ เคาน์เตอร์"/><button class="button" type="submit">ยืนยันรับเงิน ฿@CourtTime.Money(Model.NetSatang)</button></form></section>
}
<a class="button secondary" asp-action="Bookings">กลับรายการจอง</a></section>
